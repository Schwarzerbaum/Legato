<!DOCTYPE html>
<html lang="de" translate="no">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="google" content="notranslate">
<title>MateScale — Construction AI</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --bg: #f7f8fc;
  --surface: #ffffff;
  --border: #e2e5ef;
  --text: #1a1f36;
  --muted: #6b7394;
  --accent: #f59e0b;
  --accent-dark: #d97706;
  --accent-soft: #fef3c7;
  --blue: #3b5bdb;
  --blue-soft: #e8edff;
  --red: #e53e3e;
  --red-soft: #fff5f5;
  --green: #16a34a;
  --green-soft: #f0fdf4;
  --navy: #1e2a4a;
  --code-bg: #0f1923;
}
body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
       background: var(--bg); color: var(--text); min-height: 100vh; }

/* HEADER */
.header { background: var(--navy); padding: 0 20px; height: 56px;
          display: flex; align-items: center; gap: 12px;
          border-bottom: 3px solid var(--accent); position: sticky; top: 0; z-index: 100; }
.logo { font-size: 20px; font-weight: 800; color: #fff; letter-spacing: -0.5px; }
.logo span { color: var(--accent); }
.sidebar-toggle { background: none; border: none; color: #8896b8; cursor: pointer;
                  font-size: 18px; padding: 4px 8px; border-radius: 6px; line-height: 1;
                  transition: background 0.15s; }
.sidebar-toggle:hover { background: rgba(255,255,255,0.1); color: #fff; }

/* SIDEBAR */
.layout { display: flex; min-height: calc(100vh - 56px); }
.sidebar { width: 200px; min-width: 200px; background: var(--surface);
           border-right: 1px solid var(--border); padding: 12px 0;
           transition: width 0.2s, min-width 0.2s, opacity 0.2s;
           overflow: hidden; }
.sidebar.collapsed { width: 0; min-width: 0; opacity: 0; }
.sidebar a { display: block; padding: 10px 20px; font-size: 13px; font-weight: 500;
             color: var(--muted); text-decoration: none; white-space: nowrap;
             border-left: 3px solid transparent; cursor: pointer;
             transition: color 0.15s, background 0.15s; }
.sidebar a:hover { color: var(--text); background: var(--bg); }
.sidebar a.active { color: var(--navy); border-left-color: var(--accent); font-weight: 700; background: var(--bg); }

/* PANELS */
.container { flex: 1; min-width: 0; padding: 24px 28px; }
.panel { display: none; }
.panel.active { display: block; }

/* STAT BAR */
.stats { display: grid; grid-template-columns: repeat(4,1fr); gap: 14px; margin-bottom: 24px; }
.stat { background: var(--surface); border: 1px solid var(--border);
        border-top: 3px solid var(--accent); border-radius: 10px; padding: 16px 20px; }
.stat .val { font-size: 24px; font-weight: 800; color: var(--navy); }
.stat .lbl { font-size: 12px; color: var(--muted); margin-top: 3px; }

/* CARD */
.card { background: var(--surface); border: 1px solid var(--border);
        border-radius: 12px; padding: 24px; margin-bottom: 18px; }
.card-title { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }
.card-title h2 { font-size: 16px; font-weight: 700; color: var(--navy); }
.card .desc { font-size: 13px; color: var(--muted); margin-bottom: 18px; line-height: 1.5; }
.icon { width: 30px; height: 30px; border-radius: 7px; background: var(--accent-soft);
        display: flex; align-items: center; justify-content: center; font-size: 15px; }

/* GRID */
.g2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.g3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14px; }
@media(max-width:640px) { .g2,.g3,.stats { grid-template-columns: 1fr; } }

/* FORM */
label { display: block; font-size: 11px; font-weight: 700; text-transform: uppercase;
        letter-spacing: 0.5px; color: var(--muted); margin: 14px 0 5px; }
input, textarea, select {
  width: 100%; padding: 9px 13px;
  background: var(--bg); border: 1.5px solid var(--border);
  border-radius: 8px; color: var(--text); font-size: 14px; font-family: inherit;
}
textarea { resize: vertical; min-height: 90px; }
input:focus, textarea:focus, select:focus {
  outline: none; border-color: var(--accent); background: #fff;
}

/* BUTTONS */
.btn { display: inline-flex; align-items: center; gap: 7px;
       padding: 9px 20px; border: none; border-radius: 8px;
       font-size: 14px; font-weight: 600; cursor: pointer; margin-top: 14px;
       transition: opacity 0.15s; }
.btn:hover { opacity: 0.88; }
.btn-primary { background: var(--navy); color: #fff; }
.btn-accent { background: var(--accent); color: var(--navy); }
.btn-ghost { background: var(--bg); color: var(--navy); border: 1.5px solid var(--border); }

/* RESULT */
.result { background: var(--code-bg); border: 1px solid #2d3748; border-radius: 10px;
          padding: 16px; margin-top: 14px; font-family: monospace; font-size: 12.5px;
          white-space: pre-wrap; max-height: 400px; overflow-y: auto;
          color: #68d391; line-height: 1.6; display: none; }
.result.err { color: #fc8181; }

/* VERDICT GRID */
.verdict { display: grid; grid-template-columns: repeat(3,1fr); gap: 12px;
           margin-top: 14px; display: none; }
.v-card { border-radius: 10px; padding: 16px; text-align: center; }
.v-card .big { font-size: 26px; font-weight: 800; }
.v-card .lbl { font-size: 12px; margin-top: 4px; }
.v-green { background: var(--green-soft); border: 1px solid #bbf7d0; }
.v-green .big { color: var(--green); }
.v-amber { background: var(--accent-soft); border: 1px solid #fde68a; }
.v-amber .big { color: var(--accent-dark); }
.v-navy { background: var(--blue-soft); border: 1px solid #bfdbfe; }
.v-navy .big { color: var(--blue); font-size: 18px; }

/* VERSUS */
.versus { display: grid; grid-template-columns: 1fr 36px 1fr; gap: 0; margin-top: 14px; display: none; }
.vs-box { border-radius: 10px; padding: 16px; }
.vs-an { background: #fff8e1; border: 1.5px solid #fde68a; }
.vs-ag { background: var(--blue-soft); border: 1.5px solid #c7d2fe; }
.vs-title { font-size: 13px; font-weight: 700; margin-bottom: 8px; }
.vs-an .vs-title { color: #92400e; }
.vs-ag .vs-title { color: #312e81; }
.vs-mid { display: flex; align-items: center; justify-content: center;
          font-size: 18px; font-weight: 900; color: var(--muted); padding-top: 36px; }

/* SOURCE VIEWER MODAL */
#src-modal-overlay {
  display:none; position:fixed; inset:0; z-index:9100;
  background:rgba(10,15,30,0.85); backdrop-filter:blur(4px);
  align-items:center; justify-content:center;
}
#src-modal-overlay.open { display:flex; }
#src-modal-box {
  width:62vw; max-width:780px; max-height:80vh;
  background:var(--surface); border:1px solid var(--border);
  border-radius:14px; display:flex; flex-direction:column;
  box-shadow:0 20px 60px rgba(0,0,0,0.5); overflow:hidden;
}
#src-modal-hdr {
  padding:14px 18px 10px; border-bottom:1px solid var(--border);
  flex-shrink:0; display:flex; flex-direction:column; gap:4px;
}
#src-modal-doc  { font-size:11px; font-weight:700; color:var(--blue); }
#src-modal-head { font-size:14px; font-weight:700; color:var(--text); }
#src-modal-badge {
  display:inline-block; background:#e0e7ff; color:#3730a3;
  border-radius:4px; padding:1px 6px; font-size:10px; font-weight:700;
  margin-top:2px; width:fit-content;
}
#src-modal-content { flex:1; overflow-y:auto; padding:16px 18px; }
#src-modal-body {
  font-size:13px; line-height:1.7; color:#e2e8f0;
  white-space:pre-wrap; word-break:break-word;
  background:#0f1923; border-radius:8px;
  padding:14px 16px; border:1px solid #2d3748;
}
#src-modal-close-btn {
  position:absolute; top:14px; right:16px;
  background:none; border:none; color:var(--muted);
  font-size:18px; cursor:pointer; padding:4px 8px; border-radius:6px;
}
#src-modal-close-btn:hover { background:var(--border); color:var(--text); }

/* KG EXPAND MODAL */
#kg-modal-overlay {
  display:none; position:fixed; inset:0; z-index:9000;
  background:rgba(10,15,30,0.88); backdrop-filter:blur(4px);
  align-items:center; justify-content:center;
}
#kg-modal-overlay.open { display:flex; }
#kg-modal-box {
  width:92vw; height:88vh; background:#0f172a;
  border:1px solid #2d3748; border-radius:16px;
  display:flex; flex-direction:column; overflow:hidden;
  box-shadow:0 24px 80px rgba(0,0,0,0.6);
}
#kg-modal-hdr {
  display:flex; align-items:center; gap:10px;
  padding:12px 18px; border-bottom:1px solid #2d3748; flex-shrink:0;
  background:#101929;
}
#kg-modal-hdr h3 { margin:0; font-size:14px; font-weight:700; color:#e2e8f0; flex:1; }
#kg-modal-close {
  background:none; border:none; color:#8896b8; cursor:pointer;
  font-size:20px; line-height:1; padding:4px 8px; border-radius:6px;
}
#kg-modal-close:hover { background:rgba(255,255,255,0.08); color:#fff; }
#kg-modal-wrap { flex:1; position:relative; overflow:hidden; }
#kg-modal-tooltip {
  position:absolute; display:none; background:#1e2a4a; color:#fff;
  padding:6px 10px; border-radius:6px; font-size:12px;
  pointer-events:none; max-width:260px; z-index:10; word-break:break-word;
}
.kg-expand-btn {
  margin-left:auto; background:none; border:1px solid #2d3748;
  color:#8896b8; border-radius:6px; padding:2px 8px; font-size:11px;
  cursor:pointer; display:flex; align-items:center; gap:4px;
  transition:all 0.15s;
}
.kg-expand-btn:hover { background:rgba(255,255,255,0.08); color:#fff; border-color:#4a5568; }

/* KG STATS BAR */
.kg-statsbar { display:flex; gap:12px; margin-bottom:16px; flex-wrap:wrap; }
.kgs { background:var(--surface); border:1px solid var(--border); border-radius:10px;
       padding:14px 20px; text-align:center; min-width:110px; }
.kgs span { display:block; font-size:28px; font-weight:800; color:var(--navy); }
.kgs label { font-size:11px; color:var(--muted); margin-top:2px; display:block; }
.kgs-amber { border-top:3px solid var(--accent); }
.kgs-amber span { color:var(--accent-dark); }
.kgs-green { border-top:3px solid #059669; }
.kgs-green span { color:#059669; }
.kgs-purple { border-top:3px solid #7c3aed; }
.kgs-purple span { color:#7c3aed; }

/* KG TOOLBAR */
.kg-toolbar { background:var(--surface); border:1px solid var(--border); border-radius:10px;
              padding:12px 16px; margin-bottom:12px; display:flex; align-items:center;
              gap:12px; flex-wrap:wrap; }
.kg-tab { padding:6px 14px; border-radius:6px; border:1px solid var(--border);
          background:var(--bg); font-size:12px; font-weight:600; cursor:pointer;
          color:var(--muted); transition:all 0.15s; }
.kg-tab.active { background:var(--navy); color:#fff; border-color:var(--navy); }
.kg-tab:hover:not(.active) { background:var(--border); }

/* KG TOOLTIP */
#kg-tooltip { display:none; position:absolute; background:#1e2a4a; color:#e2e8f0;
              padding:10px 14px; border-radius:8px; font-size:12px; pointer-events:none;
              max-width:220px; z-index:10; box-shadow:0 4px 16px rgba(0,0,0,0.4);
              line-height:1.5; }

/* KG LEGEND */
.kg-legend { display: flex; gap: 14px; flex-wrap: wrap; font-size: 12px; }
.dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; margin-right: 4px; }

/* DOC INTELLIGENCE PANEL */
.doc-stat-bar { display:grid; grid-template-columns:repeat(7,1fr); gap:0; border:1px solid var(--border); border-radius:10px; overflow:hidden; margin-bottom:14px; }
.doc-stat-cell { padding:14px 12px; border-right:1px solid var(--border); background:var(--surface); }
.doc-stat-cell:last-child { border-right:none; }
.doc-stat-cell .val { font-size:22px; font-weight:900; color:var(--navy); line-height:1; }
.doc-stat-cell .lbl { font-size:9px; color:var(--muted); margin-top:3px; text-transform:uppercase; letter-spacing:0.5px; }
.doc-stat-cell .sub { font-size:10px; color:var(--blue); margin-top:1px; }
.doc-grid { display:grid; grid-template-columns:1fr 1fr 1fr; grid-template-rows:280px 280px; gap:1px; background:var(--border); border:1px solid var(--border); border-radius:10px; overflow:hidden; margin-top:0; }
.doc-pnl { background:var(--surface); overflow:hidden; display:flex; flex-direction:column; }
.doc-pnl-hdr { padding:10px 14px; border-bottom:1px solid var(--border); display:flex; align-items:center; gap:7px; flex-shrink:0; }
.doc-pnl-hdr h3 { font-size:12px; font-weight:700; color:var(--navy); margin:0; }
.doc-pnl-hdr .cnt { margin-left:auto; background:var(--navy); color:#fff; border-radius:10px; padding:1px 7px; font-size:9px; font-weight:700; }
.doc-pnl-body { flex:1; overflow-y:auto; padding:10px 14px; font-size:11px; }
.doc-tb { padding:4px 0; border-bottom:1px solid var(--border); display:flex; gap:7px; align-items:baseline; }
.doc-tb .pg { background:#e0e7ff; color:#4338ca; border-radius:3px; padding:1px 4px; font-size:9px; font-weight:700; white-space:nowrap; }
.doc-tb .sz { color:var(--muted); font-size:9px; white-space:nowrap; }
.doc-tb.is-bold .content { font-weight:700; }
.doc-img-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:7px; }
.doc-img-card { border:1px solid var(--border); border-radius:7px; overflow:hidden; }
.doc-img-card img { width:100%; height:72px; object-fit:cover; display:block; }
.doc-img-card .no-prev { height:72px; background:#f1f5f9; display:flex; align-items:center; justify-content:center; color:var(--muted); font-size:9px; }
.doc-img-card .meta { padding:4px 6px; font-size:9px; color:var(--muted); }
.doc-kg-rel { padding:5px 0; border-bottom:1px solid var(--border); display:flex; gap:5px; align-items:center; }
.qa-chip { background:var(--bg); border:1px solid var(--border); border-radius:20px; padding:4px 12px; font-size:11px; color:var(--blue); cursor:pointer; white-space:nowrap; transition:background 0.15s; }
.qa-chip:hover { background:var(--blue); color:#fff; border-color:var(--blue); }
.doc-kg-method { border-radius:3px; padding:1px 5px; font-size:9px; font-weight:700; color:#fff; white-space:nowrap; background:#7c3aed; }
.doc-kg-nodes { flex:1; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
.doc-diag-row { padding:5px 0; border-bottom:1px solid var(--border); display:flex; gap:6px; align-items:center; }
.doc-diag-pg { background:var(--navy); color:#fff; border-radius:3px; padding:1px 5px; font-size:9px; font-weight:700; min-width:24px; text-align:center; }
.doc-diag-bar { border-radius:3px; padding:1px 5px; font-size:9px; font-weight:600; }
.doc-loading { text-align:center; padding:40px 20px; color:var(--muted); }
.doc-extract-btn-bar { display:flex; align-items:center; gap:10px; margin-bottom:14px; flex-wrap:wrap; }
</style>
</head>
<body>

<div class="header">
  <button class="sidebar-toggle" onclick="toggleSidebar()" title="Toggle tools">☰</button>
  <div class="logo">Mate<span>Scale</span></div>
</div>

<div class="layout">
<div class="sidebar" id="main-sidebar">
  <a onclick="show('documents',this)" class="active">📄 Document Intel</a>
  <a onclick="show('bim-rag',this)">🔬 BIM RAG Pipeline</a>
  <a onclick="show('kg',this)">🕸️ Knowledge Graph</a>
  <a onclick="show('memory',this)">🧠 SONA Memory Stack</a>
  <!-- hidden until Stage 2
  <a onclick="show('nachtrag',this)">Nachtragsprüfung</a>
  <a onclick="show('vendor',this)">Vendor Risk Index</a>
  <a onclick="show('cascade',this)">Schedule Cascade</a>
  <a onclick="show('mesh',this)">Contractual Mesh</a>
  <a onclick="show('legaltwin',this)">Legal-Twin KG</a>
  <a onclick="show('pheromones',this)">Pheromone Heat Map</a>
  -->
</div>

<div class="container">

<!-- ═══ NACHTRAG ═══ -->
<div id="panel-nachtrag" class="panel">
  <div class="stats">
    <div class="stat"><div class="val">6</div><div class="lbl">VOB/B Rules</div></div>
    <div class="stat"><div class="val" id="n-ms">—</div><div class="lbl">Pre-screen ms</div></div>
    <div class="stat"><div class="val">VOB/B</div><div class="lbl">Legal Framework</div></div>
    <div class="stat"><div class="val">§2,§4,§6</div><div class="lbl">Core Paragraphs</div></div>
  </div>
  <div class="card">
    <div class="card-title"><div class="icon">N</div><h2>Nachtragsprüfung Engine</h2></div>
    <p class="desc">VOB/B-grounded pre-litigation risk assessment. Deterministic procedural checks run instantly. Outputs Financial Risk Exposure Score.</p>
    <div class="g2">
      <div><label>Nachtrag ID</label><input id="n-id" value="N-007"></div>
      <div><label>Forderungsbetrag (EUR)</label><input id="n-val" type="number" value="48500"></div>
    </div>
    <label>Nachtrag Text</label>
    <textarea id="n-text" rows="5">Nachtrag Nr. 7: Fassadenmaterial

Aufgrund der schriftlichen Anordnung des Auftraggebers vom 15.03.2026 wurde das Fassadenmaterial von Putz (Position 05.02.001) auf Klinker geaendert. Mehrkosten EUR 48.500,00 netto.

Grundlage: VOB/B §2 Abs. 5 (schriftliche Anordnung liegt vor). Aufmass gemeinsam mit Bauleiter am 20.03.2026 aufgenommen.</textarea>
    <div class="g2">
      <div>
        <label>Original LV (relevant)</label>
        <textarea id="n-lv" rows="3">Position 05.02.001: Aussenwandputz, Kalkzementputz zweilagig
Einheitspreis: EUR 28,50/m2 x 850 m2 = EUR 24.225,00</textarea>
      </div>
      <div>
        <label>Schriftverkehr / Protokolle</label>
        <textarea id="n-corr" rows="3">Email AG vom 14.03.2026: Bitte aendern Sie das Fassadenmaterial auf Klinker. Beauftragung erfolgt hiermit schriftlich.
Protokoll 15.03.2026: Aenderung bestaetigt.</textarea>
      </div>
    </div>
    <div class="g2">
      <div><label>Vertragsart</label>
        <select id="n-contract"><option value="VOB/B">VOB/B</option><option value="BGB">BGB</option></select></div>
      <div><label>Pauschalvertrag</label>
        <select id="n-pauschal"><option value="false">Nein (Einheitspreisvertrag)</option><option value="true">Ja</option></select></div>
    </div>
    <button class="btn btn-accent" onclick="runNachtrag()">Nachtrag pruefen</button>
    <div class="verdict" id="n-verdict">
      <div class="v-card v-green"><div class="big" id="v-pct">—</div><div class="lbl">Likely Award %</div></div>
      <div class="v-card v-amber"><div class="big" id="v-eur">—</div><div class="lbl">Expected EUR</div></div>
      <div class="v-card v-navy"><div class="big" id="v-rec">—</div><div class="lbl">Recommendation</div></div>
    </div>
    <div class="result" id="n-result"></div>
  </div>
</div>

<!-- ═══ ADVERSARIAL ═══ -->
<div id="panel-adversarial" class="panel">
  <div class="card">
    <div class="card-title"><div class="icon">A</div><h2>Adversarial Clause Analysis</h2></div>
    <p class="desc">Two opposing AI agents argue the same clause simultaneously. AN maximizes claim, AG weaponizes documentation gaps. Dissonance marks contested zones.</p>
    <label>Analysis Mode</label>
    <select id="adv-mode">
      <option value="nachtrag">Nachtrag Claim (VOB/B §2)</option>
      <option value="mangel">Maengelruege (VOB/B §13)</option>
      <option value="vertragsstrafe">Vertragsstrafe (VOB/B §5)</option>
    </select>
    <label>Clause Text to Analyse</label>
    <textarea id="adv-text" rows="7">§ 8 Leistungsaenderungen

Der Auftraggeber ist berechtigt, Aenderungen des Leistungsumfangs anzuordnen. Der Auftragnehmer ist verpflichtet, die geaenderten Leistungen auszufuehren. Eine Verguetungsanpassung erfolgt nach VOB/B §2. Der Auftragnehmer hat Mehrkosten vor Ausfuehrung anzumelden. Muendliche Anordnungen werden nachtraeglich schriftlich bestaetigt.</textarea>
    <label>Additional Context (optional)</label>
    <textarea id="adv-ctx" rows="2" placeholder="e.g. Pauschalvertrag, specific conditions..."></textarea>
    <button class="btn btn-accent" onclick="runAdversarial()">Run Adversarial Analysis</button>
    <div class="versus" id="adv-versus">
      <div class="vs-box vs-an">
        <div class="vs-title">Auftragnehmer (AN)</div>
        <div id="adv-an" style="font-size:13px;line-height:1.6;color:#78350f;"></div>
        <div style="margin-top:8px;font-size:12px;color:#92400e;">Staerke: <span id="adv-an-s">—</span></div>
      </div>
      <div class="vs-mid">VS</div>
      <div class="vs-box vs-ag">
        <div class="vs-title">Auftraggeber (AG)</div>
        <div id="adv-ag" style="font-size:13px;line-height:1.6;color:#312e81;"></div>
        <div style="margin-top:8px;font-size:12px;color:#3730a3;">Staerke: <span id="adv-ag-s">—</span></div>
      </div>
    </div>
    <div class="result" id="adv-result"></div>
  </div>
</div>

<!-- ═══ VENDOR ═══ -->
<div id="panel-vendor" class="panel">
  <div class="card">
    <div class="card-title"><div class="icon">V</div><h2>Record Behavioral Event</h2></div>
    <p class="desc">Each event strengthens the SM-2 pattern score. Strength >= 0.75 across 3+ projects = permanent institutional memory.</p>
    <label>Vendor Name</label><input id="v-name" value="Mustermann Tiefbau GmbH">
    <div class="g2">
      <div><label>Projekt ID</label><input id="v-pid" value="PRJ-2024-C"></div>
      <div><label>Projekt Name</label><input id="v-pname" value="Logistikzentrum Berlin"></div>
    </div>
    <label>Verhaltensmuster</label>
    <select id="v-pattern">
      <option value="baugrundrisiko_serial">Serieller Baugrundrisiko-Klaeger</option>
      <option value="claim_maximizer">Claim Maximierer</option>
      <option value="delay_claimer">Verzoegerungs-Klaeger</option>
      <option value="documentation_avoider">Dokumentationsmuffel</option>
      <option value="quality_risk">Qualitaetsrisiko</option>
      <option value="reliable_contractor">Zuverlaessiger Auftragnehmer</option>
    </select>
    <div class="g2">
      <div><label>Nachtragswert (EUR)</label><input id="v-claim" type="number" value="41000"></div>
      <div><label>SM-2 Qualitaet (1-5)</label><input id="v-qual" type="number" value="5" min="1" max="5"></div>
    </div>
    <label>Beweistext</label>
    <textarea id="v-ev" rows="2">Nachtrag fuer kontaminiertes Erdreich - Altlastenverdacht nicht erkennbar beim Baugrundgutachten</textarea>
    <button class="btn btn-primary" onclick="recordEvent()">Ereignis erfassen</button>
    <div class="result" id="v-result"></div>
  </div>
  <div class="card">
    <div class="card-title"><div class="icon">P</div><h2>Beschaffungspruefung</h2></div>
    <p class="desc">Check vendor history before signing a new contract. Surfaces permanent behavioral patterns.</p>
    <div class="g2">
      <div><label>Vendor Name</label><input id="pc-name" value="Mustermann Tiefbau GmbH"></div>
      <div><label>Auftragswert (EUR)</label><input id="pc-val" type="number" value="850000"></div>
    </div>
    <button class="btn btn-accent" onclick="procurementCheck()">Beschaffungspruefung starten</button>
    <div class="result" id="pc-result"></div>
  </div>
</div>

<!-- ═══ CASCADE ═══ -->
<div id="panel-cascade" class="panel">
  <div class="card">
    <div class="card-title"><div class="icon">C</div><h2>Schedule-Aware Risk Cascade</h2></div>
    <p class="desc">CPM-integrated delay propagation along schedule dependencies. Triggers VOB/B §6 Behinderungsanzeige alerts with deadlines.</p>
    <button class="btn btn-ghost" onclick="loadDemoSchedule()">Demo-Terminplan laden (5 Gewerke)</button>
    <div class="result" id="sched-result"></div>
    <div class="g3" style="margin-top:16px;">
      <div><label>Projekt ID</label><input id="c-proj" value="PRJ-DEMO-2026"></div>
      <div><label>Trigger Node ID</label><input id="c-node" value="T001"></div>
      <div><label>Verzoegerung (Tage)</label><input id="c-days" type="number" value="14"></div>
    </div>
    <button class="btn btn-accent" onclick="runCascade()">Kaskade berechnen</button>
    <div class="result" id="c-result"></div>
  </div>
</div>

<!-- ═══ MESH ═══ -->
<div id="panel-mesh" class="panel">
  <div class="card">
    <div class="card-title"><div class="icon">M</div><h2>Cross-Document Contractual Mesh</h2></div>
    <p class="desc">Deterministic legal graph from GAEB Positionsnummern, VOB/B paragraphs, and document hierarchy. No text similarity — structural legal relationships only.</p>
    <label>Dokumente (JSON: doc_id, filename, text)</label>
    <textarea id="m-docs" rows="14">[
  {
    "doc_id": 1,
    "filename": "Hauptvertrag_Musteranlage.pdf",
    "text": "Werkvertrag nach VOB/B. Verguetung gem. VOB/B §2. Abnahme gem. VOB/B §12. Gewaehrleistung 4 Jahre gem. VOB/B §13 Abs. 4."
  },
  {
    "doc_id": 2,
    "filename": "Leistungsverzeichnis_Los1.gaeb",
    "text": "Leistungsverzeichnis Los 1. Position 01.01.001: Aushub 450m3. Position 01.02.001: Betonage 85m3. Position 02.01.001: Mauerwerk 320m2. DIN 18300 DIN 18331."
  },
  {
    "doc_id": 3,
    "filename": "Nachtrag_007_Fassade.pdf",
    "text": "Nachtrag Nr. 7 zu Position 05.02.001. Schriftliche Anordnung AG gem. VOB/B §2 Abs. 5. Mehrkosten EUR 48.500. DIN 105."
  }
]</textarea>
    <button class="btn btn-accent" onclick="buildMesh()">Mesh aufbauen</button>
    <div class="result" id="m-result"></div>
  </div>
</div>

<!-- ═══ KG SEARCH ═══ -->
<div id="panel-kg" class="panel">
  <div class="card">
    <div class="card-title"><div class="icon">K</div><h2>Knowledge Graph — Build + Hybrid Search</h2></div>
    <p class="desc">Entity extraction + BM25 / Personalized PageRank fusion. Finds multi-hop connections missed by pure semantic search.</p>
    <label>Document Text</label>
    <textarea id="kg-text" rows="7">Werkvertrag zwischen Mustermann Bau GmbH (Auftraggeber) und Schmidt Tiefbau GmbH (Auftragnehmer). Auftragssumme EUR 2.400.000. Bauleiter: Dipl.-Ing. Thomas Meier. Architekt: Planungsbuero Weber GmbH. Vertragsstrafe 0,2% pro Werktag max 5%. Gewaehrleistung 4 Jahre gem. VOB/B §13. Sicherheitseinbehalt 5%.</textarea>
    <div class="g2">
      <div><label>Document ID</label><input id="kg-id" type="number" value="100"></div>
      <div><label>Filename</label><input id="kg-fn" value="Werkvertrag.pdf"></div>
    </div>
    <button class="btn btn-primary" onclick="buildKG()" style="margin-right:8px;">Build KG</button>
    <button class="btn btn-ghost" onclick="kgStats()">Stats</button>
    <div class="result" id="kg-build"></div>
  </div>
  <div class="card">
    <div class="card-title"><div class="icon">S</div><h2>Hybrid Search (BM25 + PPR)</h2></div>
    <div class="g2">
      <div><label>Query</label><input id="kg-q" value="Vertragsstrafe Verzoegerung" placeholder="e.g. Vertragsstrafe, Bauleiter..."></div>
      <div><label>Top K</label><input id="kg-k" type="number" value="10"></div>
    </div>
    <button class="btn btn-accent" onclick="searchKG()">Search</button>
    <div class="result" id="kg-search"></div>
  </div>
</div>

<!-- ═══ COMPANY MEMORY ═══ -->
<div id="panel-memory" class="panel">
  <div class="card">
    <div class="card-title"><div class="icon">🧠</div><h2>Company Knowledge — Agentic Memory</h2></div>
    <p class="desc">Pre-confirmed facts injected into every KG build at Stage 2.5 with confidence=1.0. Use this to tell the system what it already knows: roles, entities, constraints that recur across projects.</p>

    <div class="g2" style="margin-bottom:12px;">
      <div>
        <label>Entity</label>
        <input id="mem-entity" placeholder="e.g. Schmidt Tiefbau GmbH" style="width:100%;">
      </div>
      <div>
        <label>Entity Type</label>
        <select id="mem-type" style="width:100%;padding:8px;border-radius:6px;border:1px solid var(--border);background:var(--bg);">
          <option value="ACTOR">ACTOR</option>
          <option value="STANDARD_OR_RULE">STANDARD_OR_RULE</option>
          <option value="CONSTRAINT">CONSTRAINT</option>
          <option value="PROCESS">PROCESS</option>
          <option value="DOCUMENT">DOCUMENT</option>
          <option value="MODEL">MODEL</option>
          <option value="INFORMATION_REQUIREMENT">INFORMATION_REQUIREMENT</option>
          <option value="DATA_ENVIRONMENT">DATA_ENVIRONMENT</option>
          <option value="LIFECYCLE_PHASE">LIFECYCLE_PHASE</option>
          <option value="CONCEPT">CONCEPT</option>
        </select>
      </div>
    </div>
    <div style="margin-bottom:12px;">
      <label>Fact</label>
      <input id="mem-fact" placeholder="e.g. is Auftragnehmer on Berlin-2024, Vertragsstrafe cap 5%" style="width:100%;">
    </div>
    <div class="g2" style="margin-bottom:12px;">
      <div><label>Source Document (optional)</label><input id="mem-source" placeholder="Werkvertrag_Berlin.pdf" style="width:100%;"></div>
      <div><label>Project ID (optional)</label><input id="mem-project" placeholder="berlin-2024" style="width:100%;"></div>
    </div>
    <button class="btn btn-primary" onclick="memAdd()">Add to Memory</button>
    <div class="result" id="mem-add-result"></div>
  </div>

  <div class="card">
    <div class="card-title"><div class="icon">📊</div><h2>Memory Statistics</h2></div>
    <div id="mem-stats" style="display:flex;gap:16px;flex-wrap:wrap;margin-bottom:4px;"></div>
  </div>

  <div class="card">
    <div class="card-title"><div class="icon">📋</div><h2>Stored Knowledge</h2></div>
    <div style="margin-bottom:10px;display:flex;gap:8px;align-items:center;">
      <input id="mem-filter-project" placeholder="Filter by project ID..." style="flex:1;padding:6px 10px;border-radius:6px;border:1px solid var(--border);background:var(--bg);">
      <button class="btn btn-ghost" onclick="memLoad()">Refresh</button>
    </div>
    <div id="mem-list" style="display:flex;flex-direction:column;gap:8px;max-height:420px;overflow-y:auto;"></div>
  </div>
</div>

<!-- ═══ LEGAL-TWIN KG ═══ -->
<div id="panel-legaltwin" class="panel">

  <!-- Stats bar like BlackSwanX -->
  <div class="kg-statsbar" id="kg-statsbar" style="display:none;">
    <div class="kgs"><span id="ks-nodes">0</span><label>entities</label></div>
    <div class="kgs"><span id="ks-edges">0</span><label>connections</label></div>
    <div class="kgs kgs-amber"><span id="ks-p1">0</span><label>inherited edges</label></div>
    <div class="kgs kgs-green"><span id="ks-p2">0</span><label>regulatory bindings</label></div>
    <div class="kgs kgs-purple"><span id="ks-p3">0</span><label>risk interfaces</label></div>
  </div>

  <!-- Toolbar -->
  <div class="kg-toolbar">
    <div style="display:flex;gap:8px;align-items:center;">
      <button class="btn btn-accent" onclick="buildDemoKG()" style="margin-top:0;padding:8px 16px;">Build Demo KG</button>
      <button class="btn btn-ghost" onclick="loadGraph()" style="margin-top:0;padding:8px 14px;">Refresh</button>
    </div>
    <div style="display:flex;gap:6px;align-items:center;">
      <button class="kg-tab active" id="kt-entity" onclick="setKGView('entity',this)">Entity Graph</button>
      <button class="kg-tab" id="kt-top" onclick="setKGView('top',this)">Top Nodes</button>
    </div>
    <input id="kg-focus" placeholder="Focus on entity..." oninput="focusNode(this.value)"
      style="width:180px;padding:8px 12px;font-size:13px;border:1.5px solid var(--border);border-radius:7px;">
  </div>

  <div id="kg-status" style="font-size:12px;color:var(--muted);margin:8px 0;">
    Click "Build Demo KG" to generate the knowledge graph from 4 sample construction documents
  </div>

  <!-- Graph -->
  <div style="position:relative;">
    <div id="kg-canvas" style="width:100%;height:520px;background:#0d1117;border-radius:12px;border:1px solid #2d3748;"></div>
    <div id="kg-tooltip"></div>
  </div>

  <!-- Legend -->
  <div class="kg-legend" style="margin:12px 0 20px;">
    <span><span class="dot" style="background:#3b5bdb;"></span>Document</span>
    <span><span class="dot" style="background:#0d7377;"></span>Company</span>
    <span><span class="dot" style="background:#7c3aed;"></span>Person</span>
    <span><span class="dot" style="background:#f59e0b;"></span>GAEB Position</span>
    <span><span class="dot" style="background:#dc2626;"></span>VOB/B</span>
    <span><span class="dot" style="background:#059669;"></span>DIN Standard</span>
    <span><span class="dot" style="background:#6366f1;"></span>Clause</span>
    <span><span class="dot" style="background:#ea580c;"></span>Nachtrag</span>
    <span style="color:var(--muted);margin-left:8px;">— explicit &nbsp;· · · inferred</span>
  </div>

  <!-- Tribunal -->
  <div class="card">
    <div class="card-title">
      <div class="icon" style="background:#e8edff;">T</div>
      <h2>Tribunal — Entity Deduplication</h2>
      <span style="margin-left:auto;font-size:12px;color:var(--muted);">Prosecutor · Defense · Judge · SHA-256 audit log</span>
    </div>
    <p class="desc">Replace single-threshold fuzzy matching with a 3-agent debate. Every merge decision gets an immutable audit hash — legally traceable.</p>
    <div class="g2">
      <div>
        <label>Entity A</label><input id="t-a" value="Schmidt Tiefbau GmbH">
        <label>Context A (doc excerpt)</label>
        <textarea id="t-ca" rows="2">Auftragnehmer fuer Erdarbeiten, Baustelle Berlin 2026</textarea>
      </div>
      <div>
        <label>Entity B</label><input id="t-b" value="Schmidt GmbH Tiefbau">
        <label>Context B (doc excerpt)</label>
        <textarea id="t-cb" rows="2">AN gem. Nachtrag Nr. 3, gleiche Baustelle, selber Bauleiter</textarea>
      </div>
    </div>
    <button class="btn btn-accent" onclick="runTribunal()">Convene Tribunal</button>

    <!-- Tribunal Visual Verdict -->
    <div id="t-visual" style="display:none;margin-top:20px;">

      <!-- Verdict Banner -->
      <div id="t-banner" style="border-radius:10px;padding:18px 24px;margin-bottom:16px;display:flex;align-items:center;gap:16px;">
        <div id="t-icon" style="font-size:32px;"></div>
        <div>
          <div id="t-decision" style="font-size:20px;font-weight:800;"></div>
          <div id="t-confidence" style="font-size:13px;margin-top:2px;opacity:0.8;"></div>
        </div>
        <div style="margin-left:auto;text-align:right;">
          <div style="font-size:11px;opacity:0.6;">AUDIT HASH</div>
          <div id="t-hash" style="font-size:11px;font-family:monospace;opacity:0.8;"></div>
        </div>
      </div>

      <!-- Three Agents -->
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-bottom:16px;">

        <!-- Prosecutor -->
        <div style="background:#fff1f2;border:1.5px solid #fecdd3;border-radius:10px;padding:16px;">
          <div style="font-size:11px;font-weight:700;color:#9f1239;letter-spacing:1px;margin-bottom:8px;">PROSECUTOR</div>
          <div style="font-size:12px;color:#be123c;margin-bottom:10px;">Argues entities DIFFER</div>
          <div id="t-prosecutor" style="font-size:12px;color:#4c0519;line-height:1.6;"></div>
        </div>

        <!-- Judge (center) -->
        <div id="t-judge-box" style="border-radius:10px;padding:16px;border:2px solid;">
          <div style="font-size:11px;font-weight:700;letter-spacing:1px;margin-bottom:8px;" id="t-judge-label">JUDGE</div>
          <div id="t-judge-sub" style="font-size:12px;margin-bottom:10px;"></div>
          <div id="t-judge-text" style="font-size:12px;line-height:1.6;"></div>
          <div style="margin-top:12px;padding-top:10px;border-top:1px solid rgba(0,0,0,0.1);">
            <div style="font-size:11px;opacity:0.6;margin-bottom:4px;">SCORE</div>
            <div style="display:flex;gap:8px;align-items:center;">
              <span id="t-pro-score" style="font-size:18px;font-weight:800;color:#dc2626;"></span>
              <span style="color:#9ca3af;">vs</span>
              <span id="t-def-score" style="font-size:18px;font-weight:800;color:#16a34a;"></span>
            </div>
          </div>
        </div>

        <!-- Defense -->
        <div style="background:#f0fdf4;border:1.5px solid #bbf7d0;border-radius:10px;padding:16px;">
          <div style="font-size:11px;font-weight:700;color:#14532d;letter-spacing:1px;margin-bottom:8px;">DEFENSE</div>
          <div style="font-size:12px;color:#15803d;margin-bottom:10px;">Argues entities SAME</div>
          <div id="t-defense" style="font-size:12px;color:#14532d;line-height:1.6;"></div>
        </div>

      </div>

      <!-- Can Trust flag -->
      <div id="t-trust" style="font-size:12px;padding:10px 14px;border-radius:8px;"></div>
    </div>

    <div class="result" id="t-result" style="display:none;"></div>
  </div>

  <div class="result" id="lkg-result" style="display:none;"></div>
</div>

<!-- ═══ PHEROMONES ═══ -->
<div id="panel-pheromones" class="panel">
  <div class="card">
    <div class="card-title"><div class="icon">P</div><h2>Construction Signal Pheromone System</h2></div>
    <p class="desc">Stigmergic signal propagation across construction documents. Agents deposit typed signals (NACHTRAG_RISK, BEHINDERUNG, MANGEL_FLAG, TERMIN_DRIFT, etc.) on document entities. When 3+ signals hit the same node, intensities compound x1.3 — those nodes glow hot on the heat map.</p>

    <button class="btn btn-accent" onclick="runPheromoneDemo()" style="margin-right:8px;">Run Demo (5 docs)</button>
    <button class="btn btn-ghost" onclick="getField()">Refresh Heat Map</button>

    <div id="ph-stats" style="font-size:12px;color:var(--muted);margin-top:10px;"></div>

    <!-- Heat Map -->
    <div id="ph-heatmap" style="margin-top:16px;display:none;">
      <div style="font-size:13px;font-weight:700;color:var(--navy);margin-bottom:10px;">Signal Heat Map — Compound nodes glow hottest</div>
      <div id="ph-bars"></div>
    </div>

    <div class="result" id="ph-result"></div>
  </div>

  <div class="card">
    <div class="card-title"><div class="icon">S</div><h2>Analyse Custom Documents</h2></div>
    <p class="desc">Paste your own construction documents to scan for risk signals and see which entities accumulate the most pheromone intensity.</p>
    <label>Documents (JSON: doc_id, filename, text)</label>
    <textarea id="ph-docs" rows="12">[
  {"doc_id": 401, "filename": "Nachtrag_Mehrkosten.pdf",
   "text": "Nachtrag fuer Mehrkosten aufgrund Leistungsaenderung. Mehrvergütung beantragt gem. VOB/B §2 Abs. 5. Zusatzleistung nicht im Pauschalpreis enthalten."},
  {"doc_id": 402, "filename": "Maengelruege.pdf",
   "text": "Mängel bei Abnahme festgestellt. Nachbesserung gefordert. Estrich mangelhaft, Elektroinstallation unvollständig. VOB/B §13 Gewaehrleistung."},
  {"doc_id": 403, "filename": "Terminverzug.pdf",
   "text": "Vertragsstrafe wegen Verzug. Terminverschiebung 21 Tage. Schadensersatz geprueft. Anwalt eingeschaltet. Bauzeitverlängerung nicht genehmigt."}
]</textarea>
    <button class="btn btn-primary" onclick="runPheromoneCustom()">Analyse Documents</button>
    <div class="result" id="ph-custom-result"></div>
  </div>
</div>

<!-- ═══ DOCUMENT PROCESSOR ═══ -->
<div id="panel-documents" class="panel active">
  <!-- Document manager -->
  <div style="background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:12px 14px;margin-bottom:12px;">
    <div style="display:flex;align-items:center;gap:8px;overflow-x:auto;min-width:0;">
      <span style="font-size:12px;font-weight:700;color:var(--text);flex-shrink:0;">Documents</span>
      <label style="display:flex;align-items:center;gap:5px;cursor:pointer;background:var(--bg);border:1px dashed var(--border);border-radius:7px;padding:4px 10px;font-size:12px;color:var(--blue);font-weight:600;flex-shrink:0;margin-top:0;">
        + Add PDF
        <input type="file" accept=".pdf" multiple id="doc-upload-input" style="display:none;" onchange="handlePdfUpload(this)">
      </label>
      <button class="btn btn-accent" onclick="runRealExtraction()" id="doc-extract-btn" style="padding:4px 12px;font-size:12px;flex-shrink:0;margin-top:0;" disabled>🔬 Extract</button>
      <button onclick="runMultiExtraction()" id="doc-multi-btn" style="padding:4px 12px;font-size:12px;background:#7c3aed;color:#fff;border:none;border-radius:8px;cursor:pointer;font-weight:600;opacity:0.4;flex-shrink:0;" disabled>🔗 Merge</button>
      <span id="doc-extract-status" style="font-size:11px;color:var(--muted);flex-shrink:0;"></span>
      <span style="margin-left:auto;background:#d1fae5;color:#065f46;border:1px solid #6ee7b7;border-radius:20px;padding:3px 9px;font-size:11px;font-weight:700;flex-shrink:0;">$0 · Local</span>
    </div>
    <!-- Loaded document list -->
    <div id="doc-list" style="display:none;margin-top:10px;display:flex;flex-wrap:wrap;gap:6px;"></div>
  </div>

  <!-- 7-cell stat bar -->
  <div class="doc-stat-bar">
    <div class="doc-stat-cell"><div class="val" id="ds-pages">—</div><div class="lbl">Pages</div></div>
    <div class="doc-stat-cell"><div class="val" id="ds-blocks">—</div><div class="lbl">Text Blocks</div></div>
    <div class="doc-stat-cell"><div class="val" id="ds-images">—</div><div class="lbl">Photos</div><div class="sub" id="ds-imgpages"></div></div>
    <div class="doc-stat-cell"><div class="val" id="ds-vectors">—</div><div class="lbl">Vector Elements</div></div>
    <div class="doc-stat-cell"><div class="val" id="ds-rels">—</div><div class="lbl">Relationships</div></div>
    <div class="doc-stat-cell"><div class="val" id="ds-kg">—</div><div class="lbl">KG Edges</div></div>
    <div class="doc-stat-cell"><div class="val" id="ds-stamps">—</div><div class="lbl">Stamps/Tables</div></div>
  </div>

  <!-- 3×2 panel grid -->
  <div class="doc-grid">

    <!-- Col 1: Text blocks -->
    <div class="doc-pnl">
      <div class="doc-pnl-hdr"><span>📝</span><h3>Text Extracted</h3><span class="cnt" id="dc-blocks">—</span></div>
      <div class="doc-pnl-body" id="dc-text-list">
        <div class="doc-loading">Click "Extract Real PDF" to begin</div>
      </div>
    </div>

    <!-- Col 2: Images -->
    <div class="doc-pnl">
      <div class="doc-pnl-hdr"><span>🖼️</span><h3>Images & Photos Found</h3><span class="cnt" id="dc-images">—</span></div>
      <div class="doc-pnl-body">
        <div class="doc-img-grid" id="dc-img-grid">
          <div class="doc-loading" style="grid-column:1/-1;">Waiting for extraction…</div>
        </div>
      </div>
    </div>

    <!-- Col 3: KG graph -->
    <div class="doc-pnl" style="overflow:hidden;">
      <div class="doc-pnl-hdr"><span>🕸️</span><h3>Knowledge Graph — Live</h3><span class="cnt" id="dc-kg">—</span><button class="kg-expand-btn" onclick="openKGModal()" title="Expand KG">⛶ Expand</button></div>
      <div style="flex:1;position:relative;" id="dc-kg-wrap">
        <div class="doc-loading">KG will render here after extraction</div>
        <div id="dc-kg-tooltip" style="position:absolute;display:none;background:#1e2a4a;color:#fff;padding:6px 10px;border-radius:6px;font-size:11px;pointer-events:none;max-width:200px;z-index:10;word-break:break-word;"></div>
      </div>
    </div>

    <!-- Col 1 row 2: Diagram structure -->
    <div class="doc-pnl">
      <div class="doc-pnl-hdr"><span>📐</span><h3>Diagram Structure (per page)</h3><span class="cnt" id="dc-diag">—</span></div>
      <div class="doc-pnl-body" id="dc-diag-list">
        <div class="doc-loading">Waiting…</div>
      </div>
    </div>

    <!-- Col 2 row 2: Tables -->
    <div class="doc-pnl">
      <div class="doc-pnl-hdr"><span>📊</span><h3>Tables Extracted</h3><span class="cnt" id="dc-tables">—</span></div>
      <div class="doc-pnl-body" id="dc-table-list">
        <div class="doc-loading">Waiting…</div>
      </div>
    </div>

    <!-- Col 3 row 2: Named KG relationships -->
    <div class="doc-pnl">
      <div class="doc-pnl-hdr"><span>🏷️</span><h3>Named KG Relationships</h3><span class="cnt" id="dc-named">—</span></div>
      <div class="doc-pnl-body" id="dc-named-list">
        <div class="doc-loading">Waiting…</div>
      </div>
    </div>

  </div><!-- /doc-grid -->

  <!-- ── Doc Q&A Chat ──────────────────────────────────────────── -->
  <div style="margin-top:18px;background:var(--surface);border:1px solid var(--border);border-radius:12px;overflow:hidden;">
    <div style="padding:11px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:8px;">
      <span style="font-size:14px;">💬</span>
      <span style="font-weight:700;font-size:13px;color:var(--text);">Would you like to ask?</span>
    </div>
    <!-- Suggested questions — populated dynamically after extraction -->
    <div id="qa-suggestions" style="padding:10px 14px 6px;display:flex;flex-wrap:wrap;gap:6px;min-height:36px;">
      <span id="qa-suggest-label" style="font-size:11px;color:var(--muted);width:100%;margin-bottom:2px;">Extract a document to see suggested questions</span>
    </div>
    <div id="qa-history" style="min-height:80px;max-height:320px;overflow-y:auto;padding:10px 16px;display:flex;flex-direction:column;gap:8px;"></div>
    <div style="border-top:1px solid var(--border);padding:8px 14px 4px;display:flex;align-items:center;gap:14px;font-size:11px;color:var(--muted);">
      <label style="display:flex;align-items:center;gap:5px;cursor:pointer;margin:0;font-size:11px;text-transform:none;letter-spacing:0;color:var(--muted);">
        <input type="checkbox" id="qa-adversarial-toggle" style="width:auto;accent-color:var(--accent);" onchange="if(this.checked)$id('qa-panel-toggle').checked=false;">
        ⚔ Jury (3 Agenten)
      </label>
      <label style="display:flex;align-items:center;gap:5px;cursor:pointer;margin:0;font-size:11px;text-transform:none;letter-spacing:0;color:var(--muted);">
        <input type="checkbox" id="qa-panel-toggle" style="width:auto;accent-color:#7c3aed;" onchange="if(this.checked)$id('qa-adversarial-toggle').checked=false;">
        🏛 Expertenpanel (6 Rollen)
      </label>
      <div style="margin-left:auto;display:flex;align-items:center;gap:5px;">
        <span style="font-size:10px;color:var(--muted);white-space:nowrap;">🤖 Model</span>
        <select id="qa-model-select" style="font-size:11px;padding:3px 6px;border-radius:6px;border:1px solid var(--border);background:var(--bg);color:var(--text);cursor:pointer;" title="Generator model (set QA_GENERATOR_MODEL env to persist)">
          <option value="llama3.2:3b">llama3.2:3b ✦ (fast, default)</option>
          <option value="phi4:14b">phi4:14b (slow ~3min)</option>
          <option value="mistral-small:24b">mistral-small:24b (slow ~3min)</option>
          <option value="qwen2.5-coder:7b">qwen2.5-coder:7b</option>
        </select>
      </div>
    </div>
    <div style="border-top:1px solid var(--border);padding:10px 14px;display:flex;gap:8px;align-items:center;">
      <input id="qa-input" type="text" placeholder="Ask anything about your documents… (Enter to send)" style="flex:1;border:1px solid var(--border);border-radius:8px;padding:9px 14px;font-size:13px;background:var(--bg);color:var(--text);font-family:inherit;outline:none;" onkeydown="if(event.key==='Enter'){sendDocQuestion();}">
      <button onclick="sendDocQuestion()" id="qa-send-btn" style="background:var(--accent);color:var(--navy);border:none;border-radius:8px;padding:9px 20px;font-weight:700;font-size:13px;cursor:pointer;white-space:nowrap;flex-shrink:0;">Ask →</button>
    </div>
  </div>

</div>

</div><!-- /container -->
</div><!-- /layout -->

<script src="/d3.min.js"></script>
<script>
// ── Navigation ──────────────────────────────────────────────────────────────
function show(name, el) {
  document.querySelectorAll('.panel').forEach(function(p) { p.classList.remove('active'); });
  document.querySelectorAll('.sidebar a').forEach(function(a) { a.classList.remove('active'); });
  var panel = document.getElementById('panel-' + name);
  if (panel) panel.classList.add('active');
  if (el) el.classList.add('active');
}

function toggleSidebar() {
  document.getElementById('main-sidebar').classList.toggle('collapsed');
}

// ── Helpers ─────────────────────────────────────────────────────────────────
function $id(id) { return document.getElementById(id); }

function setResult(id, data, isErr) {
  var el = $id(id);
  el.className = isErr ? 'result err' : 'result';
  el.style.display = 'block';
  el.textContent = typeof data === 'string' ? data : JSON.stringify(data, null, 2);
}

function loading(id, msg) {
  var el = $id(id);
  el.className = 'result';
  el.style.display = 'block';
  el.textContent = '...' + (msg || 'Loading');
}

async function post(url, body) {
  var r = await fetch(url, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(body)
  });
  if (!r.ok) { var t = await r.text(); throw new Error(t); }
  return r.json();
}

// ── Nachtrag ─────────────────────────────────────────────────────────────────
async function runNachtrag() {
  loading('n-result', 'Pruefe Nachtrag...');
  $id('n-verdict').style.display = 'none';
  var t0 = Date.now();
  try {
    var data = await post('/api/matescale/nachtrag/pruefen', {
      nachtrag_id: $id('n-id').value,
      claim_value_eur: parseFloat($id('n-val').value),
      nachtrag_text: $id('n-text').value,
      original_lv_text: $id('n-lv').value,
      correspondence_text: $id('n-corr').value,
      contract_type: $id('n-contract').value,
      is_pauschalvertrag: $id('n-pauschal').value === 'true'
    });
    $id('n-ms').textContent = (Date.now() - t0) + 'ms';
    if (data.likely_outcome_pct !== undefined) {
      $id('n-verdict').style.display = 'grid';
      $id('v-pct').textContent = data.likely_outcome_pct + '%';
      var mid = data.estimated_exposure && data.estimated_exposure.midpoint_eur;
      $id('v-eur').textContent = mid ? 'EUR ' + mid.toLocaleString('de-DE') : '—';
      $id('v-rec').textContent = (data.recommendation || '').replace(/_/g, ' ');
    }
    var lines = [
      '=== NACHTRAGSPRUEFUNG ' + (data.nachtrag_id||'') + ' ===',
      '',
      'RECOMMENDATION: ' + (data.recommendation||'—'),
      data.recommendation_reasoning || '',
      '',
      'Claim value:     EUR ' + ((data.claim_value_eur||0).toLocaleString('de-DE')),
      'Likely outcome:  ' + (data.likely_outcome_pct||0) + '%',
      'Expected range:  EUR ' + ((data.estimated_exposure||{}).min_eur||0).toLocaleString('de-DE') +
                        ' – EUR ' + ((data.estimated_exposure||{}).max_eur||0).toLocaleString('de-DE'),
      'Risk score:      ' + (data.risk_score||0) + '/100',
    ];
    if (data.decisive_factor) { lines.push(''); lines.push('Key factor: ' + data.decisive_factor); }
    if ((data.documentation_gaps||[]).length) {
      lines.push(''); lines.push('Documentation gaps:');
      data.documentation_gaps.forEach(function(g){ lines.push('  • ' + g); });
    }
    if ((data.an_procedural_arguments||[]).length) {
      lines.push(''); lines.push('AN arguments (procedural):');
      data.an_procedural_arguments.forEach(function(a){ lines.push('  + ' + a); });
    }
    if ((data.ag_procedural_arguments||[]).length) {
      lines.push(''); lines.push('AG arguments (procedural):');
      data.ag_procedural_arguments.forEach(function(a){ lines.push('  - ' + a); });
    }
    if (data.mode) { lines.push(''); lines.push('Mode: ' + data.mode); }
    setResult('n-result', lines.join('\n'));
  } catch(e) { setResult('n-result', 'Error: ' + e.message, true); }
}

// ── Adversarial ───────────────────────────────────────────────────────────────
async function runAdversarial() {
  loading('adv-result', 'Deploying adversarial agents...');
  $id('adv-versus').style.display = 'none';
  try {
    var data = await post('/api/matescale/adversarial/analyse', {
      clause_text: $id('adv-text').value,
      context: $id('adv-ctx').value,
      mode: $id('adv-mode').value
    });
    $id('adv-versus').style.display = 'grid';
    $id('adv-an').innerHTML = (data.an_arguments || []).map(function(a){ return '• ' + a; }).join('<br>');
    $id('adv-ag').innerHTML = (data.ag_arguments || []).map(function(a){ return '• ' + a; }).join('<br>');
    $id('adv-an-s').textContent = data.an_strength ? Math.round(data.an_strength*100)+'%' : '—';
    $id('adv-ag-s').textContent = data.ag_strength ? Math.round(data.ag_strength*100)+'%' : '—';
    var lines = [
      'Mode: ' + (data.mode||'').toUpperCase(),
      'AN strength: ' + Math.round((data.an_strength||0)*100) + '%  |  AG strength: ' + Math.round((data.ag_strength||0)*100) + '%',
    ];
    if (data.dissonance_detected) {
      lines.push(''); lines.push('DISSONANCE DETECTED — contested clause, high negotiation risk');
    }
    if (data.vob_refs) { lines.push('VOB/B refs: ' + (data.vob_refs||[]).join(', ')); }
    setResult('adv-result', lines.join('\n'));
  } catch(e) { setResult('adv-result', 'Error: ' + e.message, true); }
}

// ── Vendor ────────────────────────────────────────────────────────────────────
async function recordEvent() {
  loading('v-result', 'Erfasse Ereignis...');
  try {
    var data = await post('/api/matescale/vendor/event', {
      vendor_name: $id('v-name').value,
      project_id: $id('v-pid').value,
      project_name: $id('v-pname').value,
      pattern_id: $id('v-pattern').value,
      claim_value_eur: parseFloat($id('v-claim').value),
      evidence_text: $id('v-ev').value
    });
    var ps = data.profile_summary || {};
    var lines = [
      'Event recorded for: ' + $id('v-name').value,
      'Pattern: ' + $id('v-pattern').options[$id('v-pattern').selectedIndex].text,
      'SM-2 strength: ' + (data.new_strength||0) + '  (repetitions: ' + (data.repetitions||0) + ')',
      data.is_permanent ? 'STATUS: PERMANENT — this pattern is now part of institutional memory' : 'Status: episodic',
      '',
      ps.risk_classification ? 'Current risk classification: ' + ps.risk_classification : '',
      ps.risk_score !== undefined ? 'Risk score: ' + ps.risk_score + '/100' : '',
      ps.active_patterns !== undefined ? 'Active patterns: ' + ps.active_patterns + '  |  Permanent: ' + (ps.permanent_patterns||0) : '',
    ].filter(Boolean);
    setResult('v-result', lines.join('\n'));
  } catch(e) { setResult('v-result', 'Error: ' + e.message, true); }
}

async function procurementCheck() {
  loading('pc-result', 'Pruefe Auftragnehmer-Historie...');
  try {
    var data = await post('/api/matescale/vendor/procurement-check', {
      vendor_name: $id('pc-name').value,
      contract_value_eur: parseFloat($id('pc-val').value)
    });
    var lines = [
      data.recommendation || '',
      '',
      'Risk Classification: ' + (data.risk_classification||'UNKNOWN'),
      'Risk Score: ' + (data.risk_score||0) + ' / 100',
      'Projects in database: ' + ((data.historical_summary||{}).projects_in_database||0),
      'Total historical claims: EUR ' + (((data.historical_summary||{}).total_claims_eur||0).toLocaleString('de-DE')),
      'Permanent patterns: ' + ((data.historical_summary||{}).permanent_patterns||0),
      '',
      'Contingency recommendation: ' + ((data.contingency_recommendation||{}).percentage||5) + '%' +
        ' = EUR ' + (((data.contingency_recommendation||{}).amount_eur||0).toLocaleString('de-DE')),
    ];
    if ((data.procurement_flags||[]).length > 0) {
      lines.push(''); lines.push('Flags:');
      (data.procurement_flags||[]).forEach(function(f){ lines.push('  ' + f); });
    }
    setResult('pc-result', lines.join('\n'));
  } catch(e) { setResult('pc-result', 'Error: ' + e.message, true); }
}

// ── Schedule Cascade ──────────────────────────────────────────────────────────
async function loadDemoSchedule() {
  loading('sched-result', 'Lade Demo-Terminplan...');
  try {
    var data = await fetch('/api/matescale/schedule/demo', {method:'POST'}).then(function(r){ return r.json(); });
    var lines = ['Demo schedule loaded — ' + (data.tasks_registered||0) + ' trades registered', ''];
    (data.nodes||[]).forEach(function(n){ lines.push('  ' + n); });
    lines.push(''); lines.push(data.tip||'');
    setResult('sched-result', lines.join('\n'));
  } catch(e) { setResult('sched-result', 'Error: ' + e.message, true); }
}

async function runCascade() {
  loading('c-result', 'Berechne Kaskade...');
  try {
    var data = await post('/api/matescale/schedule/cascade', {
      project_id: $id('c-proj').value,
      trigger_node_id: $id('c-node').value,
      delay_days: parseInt($id('c-days').value),
      initial_strength: 1.0
    });
    var s = data.cascade_summary || {};
    var lines = [
      data.recommendation || '',
      '',
      'Affected trades: ' + (s.affected_nodes||0),
      'Cascade depth: ' + (s.cascade_depth||0) + ' levels',
      'Total exposure: EUR ' + ((s.total_exposure_eur||0).toLocaleString('de-DE')),
      'Critical path: ' + (s.critical_path_impact ? 'YES' : 'No'),
      '',
      'VOB/B rights triggered:',
    ].concat((data.vob_rights_triggered||[]).map(function(r){ return '  • ' + r; }));
    if (data.behinderungsanzeige_deadline) {
      lines.push('');
      lines.push('Behinderungsanzeige deadline: ' + data.behinderungsanzeige_deadline);
    }
    if ((data.affected_nodes||[]).length > 0) {
      lines.push('');
      lines.push('Downstream impact:');
      (data.affected_nodes||[]).forEach(function(n){
        lines.push('  ' + n.name + ' (' + (n.subcontractor||'?') + ')' +
          ' — +'+ n.downstream_delay_days +'d · EUR '+ (n.financial_exposure_eur||0).toLocaleString('de-DE'));
      });
    }
    setResult('c-result', lines.join('\n'));
  } catch(e) { setResult('c-result', 'Error: ' + e.message, true); }
}

// ── Contractual Mesh ──────────────────────────────────────────────────────────
async function buildMesh() {
  loading('m-result', 'Baue Contractual Mesh...');
  try {
    var docs = JSON.parse($id('m-docs').value);
    var data = await post('/api/matescale/mesh/build', { documents: docs });
    var lines = [
      'Contractual Mesh built successfully',
      '',
      'Documents: ' + (data.documents_registered||0),
      'Doc types: ' + (data.doc_types||[]).join(', '),
      'Total nodes: ' + (data.total_nodes||0),
      'Total edges: ' + (data.total_edges||0),
      'GAEB positions found: ' + (data.unique_positions||0),
      'Cross-document positions: ' + (data.cross_doc_positions||0),
      '',
      'Pass 1 (Hierarchy edges): ' + ((data.pass_1_hierarchy||{}).edges_added||0),
      'Pass 2 (GAEB linking): ' + ((data.pass_2_gaeb_positions||{}).edges_added||0),
      'Pass 3 (VOB/DIN refs): ' + ((data.pass_3_legal_refs||{}).edges_added||0),
    ];
    setResult('m-result', lines.join('\n'));
  } catch(e) { setResult('m-result', 'Error: ' + e.message, true); }
}

// ── KG Search ─────────────────────────────────────────────────────────────────
async function buildKG() {
  loading('kg-build', 'Building KG...');
  try {
    var data = await post('/api/matescale/kg/build', {
      doc_id: parseInt($id('kg-id').value),
      filename: $id('kg-fn').value,
      text: $id('kg-text').value
    });
    var lines = [
      'KG built — doc type: ' + (data.doc_type_detected||'UNKNOWN'),
      'Nodes: ' + (data.nodes||0) + '  |  Edges: ' + (data.edges||0),
      'Regulatory edges (Pass 2): ' + (data.pass2_regulatory_edges||0),
      '', data.tip||''
    ];
    setResult('kg-build', lines.join('\n'));
  } catch(e) { setResult('kg-build', 'Error: ' + e.message, true); }
}

async function kgStats() {
  loading('kg-build', 'Fetching stats...');
  try {
    var data = await fetch('/api/matescale/kg/stats').then(function(r){ return r.json(); });
    setResult('kg-build', 'Nodes: ' + (data.nodes||0) + '  |  Edges: ' + (data.edges||0) + '\nSource: ' + (data.source||'legal_kg'));
  } catch(e) { setResult('kg-build', 'Error: ' + e.message, true); }
}

async function searchKG() {
  loading('kg-search', 'Running BM25 + PPR search...');
  try {
    var data = await post('/api/matescale/kg/search', {
      query: $id('kg-q').value,
      top_k: parseInt($id('kg-k').value)
    });
    var results = data.results || [];
    var lines = ['Query: "' + data.query + '"  —  ' + results.length + ' results', ''];
    results.forEach(function(r, i){
      lines.push((i+1) + '. ' + (r.name||r.id||'').slice(0,50) +
        '  [' + (r.entity_type||r.type||'?') + ']' +
        '  score=' + (r.score||0).toFixed(3));
    });
    if (!results.length) lines.push('No results — build the KG first');
    setResult('kg-search', lines.join('\n'));
  } catch(e) { setResult('kg-search', 'Error: ' + e.message, true); }
}

// ── Company Memory ─────────────────────────────────────────────────────────────
async function memAdd() {
  var entity = $id('mem-entity').value.trim();
  var fact   = $id('mem-fact').value.trim();
  if (!entity || !fact) { setResult('mem-add-result', 'Entity and Fact are required.', true); return; }
  loading('mem-add-result', 'Storing...');
  try {
    var data = await post('/api/matescale/memory/add', {
      entity:      entity,
      entity_type: $id('mem-type').value,
      fact:        fact,
      source_doc:  $id('mem-source').value.trim(),
      project_id:  $id('mem-project').value.trim(),
      confidence:  1.0
    });
    setResult('mem-add-result', '✅ Stored — id: ' + data.id);
    $id('mem-entity').value = '';
    $id('mem-fact').value   = '';
    memLoad();
  } catch(e) { setResult('mem-add-result', 'Error: ' + e.message, true); }
}

async function memLoad() {
  var proj = ($id('mem-filter-project') || {}).value || '';
  var url  = '/api/matescale/memory/list' + (proj ? '?project_id=' + encodeURIComponent(proj) : '');
  // Load stats and list in parallel
  try {
    var [listData, statsData] = await Promise.all([
      fetch(url).then(r => r.json()),
      fetch('/api/matescale/memory/stats').then(r => r.json()).catch(() => null)
    ]);
    // Render stats bar
    if (statsData) {
      var statsEl = $id('mem-stats');
      var statItems = [
        { label: 'Total', val: statsData.total, color: 'var(--navy)' },
        { label: 'Permanent', val: statsData.permanent, color: '#10b981' },
        { label: 'Auto-learned', val: statsData.auto_learned, color: '#3b82f6' },
        { label: 'Manual', val: statsData.manually_added, color: '#8b5cf6' },
      ];
      statsEl.innerHTML = statItems.map(function(s) {
        return '<div style="flex:1;min-width:80px;text-align:center;padding:10px;background:var(--bg);border:1px solid var(--border);border-radius:8px;">' +
          '<div style="font-size:22px;font-weight:900;color:' + s.color + ';">' + s.val + '</div>' +
          '<div style="font-size:10px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.5px;">' + s.label + '</div>' +
        '</div>';
      }).join('');
    }
    // Render entries
    var entries = listData.entries || [];
    var container = $id('mem-list');
    if (!entries.length) {
      container.innerHTML = '<div style="color:var(--muted);font-size:13px;padding:12px 0;">No entries yet — upload and extract a document, or add manually above.</div>';
      return;
    }
    var typeColors = {
      ACTOR:'#3b82f6', STANDARD_OR_RULE:'#8b5cf6', CONSTRAINT:'#ef4444',
      PROCESS:'#f59e0b', DOCUMENT:'#10b981', MODEL:'#06b6d4',
      INFORMATION_REQUIREMENT:'#ec4899', DATA_ENVIRONMENT:'#6366f1',
      LIFECYCLE_PHASE:'#84cc16', CONCEPT:'#94a3b8',
      PROJECT:'#fb923c', ASSET:'#34d399', SOFTWARE_OR_TOOL:'#22d3ee'
    };
    container.innerHTML = entries.map(function(e) {
      var col = typeColors[e.entity_type] || '#94a3b8';
      var strength = e.memory_strength || 0.1;
      var isPerm   = e.is_permanent === 1;
      var strengthPct = Math.round(strength * 100);
      var strengthCol = strength >= 0.75 ? '#10b981' : strength >= 0.4 ? '#f59e0b' : '#94a3b8';
      var truth = e.generalized_truth || '';
      return '<div style="padding:10px 12px;background:var(--bg);border:1px solid var(--border);border-radius:8px;border-left:3px solid ' + (isPerm ? '#10b981' : strengthCol) + ';">' +
        '<div style="display:flex;align-items:flex-start;gap:8px;">' +
          '<div style="flex:1;min-width:0;">' +
            '<div style="display:flex;align-items:center;gap:6px;margin-bottom:4px;flex-wrap:wrap;">' +
              (isPerm ? '<span style="font-size:9px;font-weight:700;color:#fff;background:#10b981;border-radius:3px;padding:1px 5px;">PERMANENT</span>' : '') +
              '<span style="font-weight:700;font-size:13px;">' + e.entity + '</span>' +
              '<span style="font-size:10px;font-weight:700;color:#fff;background:' + col + ';border-radius:4px;padding:1px 6px;">' + e.entity_type + '</span>' +
              (e.project_id ? '<span style="font-size:10px;color:var(--muted);background:var(--border);border-radius:4px;padding:1px 6px;">' + e.project_id + '</span>' : '') +
              '<span style="font-size:10px;color:var(--muted);">×' + (e.repetition_count || 1) + '</span>' +
            '</div>' +
            '<div style="font-size:12px;color:var(--text);margin-bottom:4px;">' + e.fact + '</div>' +
            (truth ? '<div style="font-size:11px;font-style:italic;color:#3b82f6;margin-bottom:4px;padding:4px 8px;background:#eff6ff;border-radius:4px;">Generalized: ' + truth + '</div>' : '') +
            '<div style="display:flex;align-items:center;gap:6px;">' +
              '<div style="flex:1;height:4px;background:var(--border);border-radius:2px;">' +
                '<div style="height:4px;border-radius:2px;background:' + strengthCol + ';width:' + strengthPct + '%;transition:width .3s;"></div>' +
              '</div>' +
              '<span style="font-size:10px;color:' + strengthCol + ';font-weight:700;min-width:30px;">' + strengthPct + '%</span>' +
              (e.source_doc ? '<span style="font-size:10px;color:var(--muted);">' + e.source_doc.split(',')[0] + '</span>' : '') +
            '</div>' +
          '</div>' +
          '<button onclick="memDelete(\'' + e.id + '\',this)" style="flex-shrink:0;background:none;border:none;cursor:pointer;color:var(--muted);font-size:14px;padding:2px 4px;" title="Delete">✕</button>' +
        '</div>' +
      '</div>';
    }).join('');
  } catch(e) { $id('mem-list').innerHTML = '<div style="color:red;font-size:12px;">Error loading: ' + e.message + '</div>'; }
}

async function memDelete(kid, btn) {
  btn.disabled = true;
  try {
    await fetch('/api/matescale/memory/' + kid, { method: 'DELETE' });
    memLoad();
  } catch(e) { btn.disabled = false; }
}

// auto-load memory list when panel opens
var _origShow = show;
show = function(name, el) {
  _origShow(name, el);
  if (name === 'memory') memLoad();
};

// ── Legal-Twin KG ─────────────────────────────────────────────────────────────
var _kgView = 'entity';
var _kgData = null;

function setKGView(view, el) {
  _kgView = view;
  document.querySelectorAll('.kg-tab').forEach(function(t){ t.classList.remove('active'); });
  el.classList.add('active');
  if (_kgData) renderGraph(_kgData);
}

function focusNode(query) {
  if (!_kgData || !query) return;
  // Highlight matching nodes
  var svg = d3.select('#kg-canvas svg');
  svg.selectAll('circle').attr('opacity', function(d){
    return (!query || (d.name||'').toLowerCase().includes(query.toLowerCase())) ? 1 : 0.15;
  });
  svg.selectAll('text').attr('opacity', function(d){
    return (!query || (d.name||'').toLowerCase().includes(query.toLowerCase())) ? 1 : 0.1;
  });
}

async function buildDemoKG() {
  $id('kg-status').textContent = 'Building Legal-Twin KG from 4 documents...';
  $id('lkg-result').style.display = 'none';
  try {
    var data = await fetch('/api/matescale/legal-kg/demo', {method:'POST'}).then(function(r){ return r.json(); });
    var s = data.stats || {};
    // Populate stats bar
    $id('kg-statsbar').style.display = 'flex';
    $id('ks-nodes').textContent = s.total_nodes || 0;
    $id('ks-edges').textContent = s.total_edges || 0;
    $id('ks-p1').textContent = s.pass1_inherited_edges || 0;
    $id('ks-p2').textContent = s.pass2_regulatory_edges || 0;
    $id('ks-p3').textContent = s.pass3_transitivity_edges || 0;
    $id('kg-status').textContent =
      'Legal-Twin KG built · ' + s.total_nodes + ' entities · ' + s.total_edges +
      ' connections · Drag to explore · Scroll to zoom · Hover for details';
    await loadGraph();
  } catch(e) {
    $id('kg-status').textContent = 'Error: ' + e.message;
  }
}

function countTypes(nodes) {
  var counts = {};
  nodes.forEach(function(n){ counts[n.type] = (counts[n.type]||0)+1; });
  return counts;
}
function countEdgeTypes(edges) {
  var counts = {};
  edges.forEach(function(e){ counts[e.type] = (counts[e.type]||0)+1; });
  return counts;
}

async function loadGraph() {
  try {
    var graph = await fetch('/api/matescale/legal-kg/graph').then(function(r){ return r.json(); });
    if (graph.nodes && graph.nodes.length > 0) renderGraph(graph);
  } catch(e) { console.error('Graph error:', e); }
}

async function runTribunal() {
  loading('t-result', 'Running 3-agent tribunal...');
  try {
    var data = await post('/api/matescale/legal-kg/tribunal', {
      entity_a: $id('t-a').value,
      entity_b: $id('t-b').value,
      context_a: $id('t-ca').value,
      context_b: $id('t-cb').value
    });
    // Show visual tribunal
    $id('t-visual').style.display = 'block';

    var isMerge = data.final_decision === 'merge';
    var isSep   = data.final_decision === 'separate';
    var conf    = Math.round((data.confidence||0)*100);
    var proLen  = (data.prosecutor_arguments||[]).length;
    var defLen  = (data.defense_arguments||[]).length;

    // Banner
    var bannerColor = isMerge ? {bg:'#f0fdf4',border:'#16a34a',text:'#14532d'} :
                      isSep   ? {bg:'#fff1f2',border:'#dc2626',text:'#9f1239'} :
                                {bg:'#fffbeb',border:'#f59e0b',text:'#92400e'};
    var banner = $id('t-banner');
    banner.style.background = bannerColor.bg;
    banner.style.border = '2px solid ' + bannerColor.border;
    $id('t-icon').textContent = isMerge ? '⚖️' : isSep ? '✂️' : '⚠️';
    $id('t-decision').style.color = bannerColor.text;
    $id('t-decision').textContent = 'VERDICT: ' + (data.final_decision||'').toUpperCase();
    $id('t-confidence').style.color = bannerColor.text;
    $id('t-confidence').textContent = 'Confidence: ' + conf + '%' +
      (conf < 50 ? ' — low confidence, consider manual review' : conf > 80 ? ' — high confidence' : '');
    $id('t-hash').textContent = (data.audit_hash||'').slice(0,20) + '...';

    // Prosecutor
    $id('t-prosecutor').innerHTML = (data.prosecutor_arguments||['No arguments']).map(function(a){
      return '<div style="margin-bottom:5px;">— ' + a + '</div>';
    }).join('');

    // Defense
    $id('t-defense').innerHTML = (data.defense_arguments||['No arguments']).map(function(a){
      return '<div style="margin-bottom:5px;">+ ' + a + '</div>';
    }).join('');

    // Judge center box
    var jBox = $id('t-judge-box');
    jBox.style.background = isMerge ? '#f0fdf4' : isSep ? '#fff1f2' : '#fffbeb';
    jBox.style.borderColor = isMerge ? '#16a34a' : isSep ? '#dc2626' : '#f59e0b';
    $id('t-judge-label').style.color = isMerge ? '#14532d' : isSep ? '#9f1239' : '#92400e';
    $id('t-judge-sub').textContent = 'Final verdict';
    $id('t-judge-sub').style.color = isMerge ? '#15803d' : isSep ? '#b91c1c' : '#d97706';
    $id('t-judge-text').textContent = (data.judge_verdict||'').replace(/^(MERGE|SEPARATE|INCONCLUSIVE):\s*/,'');
    $id('t-judge-text').style.color = '#374151';
    $id('t-pro-score').textContent = proLen;
    $id('t-def-score').textContent = defLen;

    // Trust flag
    var trust = $id('t-trust');
    if (data.can_trust) {
      trust.style.background = '#f0fdf4'; trust.style.color = '#14532d';
      trust.style.border = '1px solid #bbf7d0';
      trust.textContent = 'Legally traceable — this decision can be used in contract disputes';
    } else {
      trust.style.background = '#fffbeb'; trust.style.color = '#92400e';
      trust.style.border = '1px solid #fde68a';
      trust.textContent = 'Low confidence — escalate to human review before merging in the KG';
    }
  } catch(e) { setResult('t-result', 'Error: ' + e.message, true); $id('t-visual').style.display='none'; }
}

// ── Pheromones ────────────────────────────────────────────────────────────────
var SIGNAL_COLORS = {
  NACHTRAG_RISK: '#f59e0b',
  BEHINDERUNG: '#3b5bdb',
  MANGEL_FLAG: '#dc2626',
  TERMIN_DRIFT: '#ea580c',
  FEHLENDE_UNTERLAGE: '#7c3aed',
  VERTRAGSSTRAFE_RISK: '#e11d48',
  AUDIT_BEACON: '#111827',
};

function renderHeatMap(data) {
  var hot = data.heat_map || data.hot_nodes || [];
  if (!hot.length) return;

  $id('ph-heatmap').style.display = 'block';
  var bars = $id('ph-bars');
  bars.innerHTML = '';

  var maxIntensity = hot.reduce(function(m,n){ return Math.max(m, n.intensity||n.total_intensity||0); }, 1);

  hot.slice(0,12).forEach(function(node) {
    var intensity = node.intensity || node.total_intensity || 0;
    var pct = Math.round((intensity / maxIntensity) * 100);
    var sig = node.dominant_signal || '';
    var color = SIGNAL_COLORS[sig] || '#6b7280';
    var compound = node.compound ? ' 🔥' : '';
    var name = (node.entity || '').replace(/['"]/g,'').slice(0,50);

    var row = document.createElement('div');
    row.style.cssText = 'margin-bottom:8px;';
    row.innerHTML =
      '<div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:3px;">' +
        '<span style="font-weight:600;">' + name + compound + '</span>' +
        '<span style="color:var(--muted);">' + sig + ' · ' + intensity.toFixed(2) + '</span>' +
      '</div>' +
      '<div style="background:var(--border);border-radius:4px;height:8px;">' +
        '<div style="background:' + color + ';width:' + pct + '%;height:100%;border-radius:4px;transition:width 0.5s;"></div>' +
      '</div>';
    bars.appendChild(row);
  });
}

async function runPheromoneDemo() {
  loading('ph-result', 'Running pheromone analysis on 5 demo documents...');
  $id('ph-heatmap').style.display = 'none';
  try {
    var data = await fetch('/api/matescale/pheromones/demo', {method:'POST'}).then(function(r){ return r.json(); });
    $id('ph-stats').textContent =
      data.signals_emitted + ' signals emitted · ' +
      (data.compound_nodes||[]).length + ' compound nodes · ' +
      'Signal types: ' + (data.signal_types||[]).join(', ');
    renderHeatMap(data);
    // Don't show raw JSON — the heat map IS the result
    $id('ph-result').style.display = 'none';
  } catch(e) { setResult('ph-result', 'Error: ' + e.message, true); }
}

async function getField() {
  try {
    var data = await fetch('/api/matescale/pheromones/field').then(function(r){ return r.json(); });
    renderHeatMap({heat_map: data.hot_nodes, compound_nodes: data.compound_nodes});
    $id('ph-stats').textContent = data.signal_count + ' active signal nodes';
  } catch(e) { console.error(e); }
}

async function runPheromoneCustom() {
  loading('ph-custom-result', 'Analysing documents...');
  try {
    var docs = JSON.parse($id('ph-docs').value);
    var data = await post('/api/matescale/pheromones/analyse', { documents: docs });
    renderHeatMap(data);
    var lines = [
      data.signals_emitted + ' signals emitted · ' + (data.compound_nodes||[]).length + ' compound nodes',
      'Signal types: ' + (data.signal_types||[]).join(', '),
    ];
    setResult('ph-custom-result', lines.join('\n'));
  } catch(e) { setResult('ph-custom-result', 'Error: ' + e.message, true); }
}

// ── Document Intelligence ─────────────────────────────────────────────────────

var DOC_NODE_C = {
  DOCUMENT:'#3b5bdb', CONCEPT:'#0d7377',
  ROLE:'#7c3aed',       // purple
  PROCESS:'#f59e0b',    // amber
  STANDARD:'#dc2626',   // red
  DELIVERABLE:'#0891b2',// cyan
  CONSTRAINT:'#16a34a', // green — temporal/numeric values
  DEFAULT:'#6b7280'
};

function buildDocKGGraph(rels) {
  // Strip vector diagram noise (box_N nodes) — only keep named concept edges
  rels = rels.filter(function(r) {
    return !(/^box_\d/i.test(r.source)) && !(/^box_\d/i.test(r.target))
        && r.source && r.target && r.source !== r.target;
  });
  if (!rels.length) return;
  // Cache for modal expand
  _kgModalRels = rels;
  var mc = $id('kg-modal-count');
  if (mc) mc.textContent = rels.length + ' edges';

  var wrap = $id('dc-kg-wrap');
  wrap.innerHTML = '<div id="dc-kg-tooltip" style="position:absolute;display:none;background:#1e2a4a;color:#fff;padding:6px 10px;border-radius:6px;font-size:11px;pointer-events:none;max-width:200px;z-index:10;word-break:break-word;"></div>';
  var W = wrap.offsetWidth || 380;
  var H = wrap.offsetHeight || 260;

  var typeGuess = function(name) {
    if (/BIM-(Management|Projektleitung|Koordination|Fach)/i.test(name)) return 'ROLE';
    if (/Foundation|Schulung|Zertifikat/i.test(name)) return 'REQUIREMENT';
    if (/Workflow|WF\d|Issue|BCF/i.test(name)) return 'WORKFLOW';
    if (/LOG|LOI|LOIN|LOD/i.test(name)) return 'STANDARD';
    if (/CDE|Modell|Archiv/i.test(name)) return 'DATA';
    if (/Prozess|Prüfung|Erstellung|Bearbeitung/i.test(name)) return 'PROCESS';
    if (/Leitfaden|Masterplan|Dokument|BIM-Leitfaden/i.test(name)) return 'DOCUMENT';
    return 'CONCEPT';
  };

  var nodeMap = {};
  rels.forEach(function(r) {
    if (!nodeMap[r.source]) nodeMap[r.source] = { id: r.source, name: r.source, type: r.source_type || typeGuess(r.source) };
    if (!nodeMap[r.target]) nodeMap[r.target] = { id: r.target, name: r.target, type: r.target_type || typeGuess(r.target) };
  });
  var nodes = Object.values(nodeMap);
  var links = rels.map(function(r) { return { source: r.source, target: r.target, type: r.type }; });

  var svg = d3.select(wrap).append('svg')
    .attr('width', W).attr('height', H)
    .style('background', '#0f172a');

  var g = svg.append('g');
  svg.call(d3.zoom().scaleExtent([0.2, 4]).on('zoom', function(e) { g.attr('transform', e.transform); }));

  var linkCount = {};
  links.forEach(function(l) {
    linkCount[l.source] = (linkCount[l.source] || 0) + 1;
    linkCount[l.target] = (linkCount[l.target] || 0) + 1;
  });

  var sim = d3.forceSimulation(nodes)
    .force('link', d3.forceLink(links).id(function(d) { return d.id; }).distance(50).strength(0.9))
    .force('charge', d3.forceManyBody().strength(-120).distanceMax(200))
    .force('center', d3.forceCenter(W / 2, H / 2).strength(0.12))
    .force('x', d3.forceX(W / 2).strength(0.06))
    .force('y', d3.forceY(H / 2).strength(0.06))
    .force('collision', d3.forceCollide(18))
    .alphaDecay(0.025);

  var link = g.append('g').selectAll('line').data(links).enter().append('line')
    .attr('stroke', '#8896b8').attr('stroke-width', 1.5).attr('stroke-opacity', 0.75);

  var tooltip = d3.select('#dc-kg-tooltip');
  var node = g.append('g').selectAll('g').data(nodes).enter().append('g')
    .call(d3.drag()
      .on('start', function(e, d) { if (!e.active) sim.alphaTarget(0.3).restart(); d.fx = d.x; d.fy = d.y; })
      .on('drag',  function(e, d) { d.fx = e.x; d.fy = e.y; })
      .on('end',   function(e, d) { if (!e.active) sim.alphaTarget(0); d.fx = null; d.fy = null; }));

  function nodeR(d) { return Math.min(7 + Math.sqrt(linkCount[d.id] || 0) * 2, 18); }

  node.append('circle')
    .attr('r', nodeR)
    .attr('fill', function(d) { return DOC_NODE_C[d.type] || DOC_NODE_C.DEFAULT; })
    .attr('stroke', 'rgba(255,255,255,0.3)').attr('stroke-width', 1).attr('opacity', 0.9)
    .on('mouseover', function(e, d) {
      tooltip.style('display', 'block')
        .style('left', (e.offsetX + 12) + 'px').style('top', (e.offsetY - 8) + 'px')
        .html('<strong>' + d.name + '</strong><br><span style="color:#8896b8;">' + d.type + '</span>' +
              (linkCount[d.id] ? '<br>Links: ' + linkCount[d.id] : ''));
    })
    .on('mouseout', function() { tooltip.style('display', 'none'); });

  node.append('text')
    .attr('x', function(d) { return nodeR(d) + 3; }).attr('dy', '0.35em')
    .attr('fill', '#cbd5e1').attr('font-size', '8px').attr('pointer-events', 'none')
    .text(function(d) { return d.name.length > 20 ? d.name.slice(0, 18) + '…' : d.name; });

  sim.on('tick', function() {
    link.attr('x1', function(d) { return d.source.x; }).attr('y1', function(d) { return d.source.y; })
        .attr('x2', function(d) { return d.target.x; }).attr('y2', function(d) { return d.target.y; });
    node.attr('transform', function(d) { return 'translate(' + d.x + ',' + d.y + ')'; });
  });
}

var _uploadedPdfPaths = [];
var API_BASE = (window.location.protocol === 'file:') ? 'http://localhost:9200' : window.location.origin;

var _docMeta = []; // {name, path}
var _activeDocIdx = 0;

function renderDocList() {
  var list = $id('doc-list');
  if (!_docMeta.length) { list.style.display = 'none'; return; }
  list.style.display = 'flex';
  list.innerHTML = _docMeta.map(function(d, i) {
    var active = i === _activeDocIdx;
    var statusIcon = d.extracting ? '⚙' : (d.extracted ? '✅' : '📄');
    var bg     = active ? 'var(--blue)'   : 'var(--bg)';
    var border = active ? 'var(--blue)'   : (d.extracted ? '#bbf7d0' : 'var(--border)');
    var color  = active ? '#fff'          : 'var(--text)';
    return '<div onclick="setActiveDoc(' + i + ')" style="display:flex;align-items:center;gap:6px;background:' + bg + ';border:1px solid ' + border + ';border-radius:7px;padding:4px 10px;font-size:11px;cursor:pointer;">' +
      '<span>' + statusIcon + '</span>' +
      '<span style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:' + color + ';" title="' + d.name + '">' + d.name + '</span>' +
      '<button onclick="event.stopPropagation();removeDoc(' + i + ')" style="background:none;border:none;color:' + (active ? 'rgba(255,255,255,0.7)' : 'var(--muted)') + ';cursor:pointer;font-size:13px;padding:0 2px;line-height:1;">×</button>' +
    '</div>';
  }).join('');
  var n = _docMeta.length;
  $id('doc-extract-btn').disabled = false;
  $id('doc-extract-btn').style.opacity = '1';
  var mb = $id('doc-multi-btn');
  if (n > 1) { mb.disabled = false; mb.style.opacity = '1'; }
  else { mb.disabled = true; mb.style.opacity = '0.4'; }
}

function setActiveDoc(idx) {
  _activeDocIdx = idx;
  renderDocList();
  $id('doc-extract-status').textContent = 'Extracting: ' + _docMeta[idx].name;
}

function removeDoc(idx) {
  _uploadedPdfPaths.splice(idx, 1);
  _docMeta.splice(idx, 1);
  if (_activeDocIdx >= _docMeta.length) _activeDocIdx = Math.max(0, _docMeta.length - 1);
  renderDocList();
  if (!_docMeta.length) {
    $id('doc-extract-btn').disabled = true;
    $id('doc-extract-btn').style.opacity = '0.4';
    $id('doc-extract-status').textContent = '';
  }
}

async function handlePdfUpload(input) {
  var files = Array.from(input.files);
  if (!files.length) return;
  var status = $id('doc-extract-status');
  status.textContent = '⏳ Uploading ' + files.length + ' file(s)…';
  var jobs = [];   // [{jobId, path, name}]

  for (var i = 0; i < files.length; i++) {
    if (_docMeta.find(function(d){ return d.name === files[i].name; })) continue;
    var form = new FormData();
    form.append('file', files[i]);
    try {
      var res = await fetch(API_BASE + '/api/matescale/documents/upload', {method:'POST', body:form});
      var data = await res.json();
      if (!data.error) {
        _uploadedPdfPaths.push(data.path);
        _docMeta.push({name: data.filename, path: data.path, extracting: true, jobId: data.job_id});
        jobs.push({jobId: data.job_id, path: data.path, name: data.filename});
      }
    } catch(e) { /* skip */ }
  }
  renderDocList();
  input.value = '';

  if (!jobs.length) { status.textContent = 'Already loaded.'; return; }
  status.textContent = '⚙ Indexing ' + jobs.length + ' doc(s) in background…';

  // ── Async polling: check each job until done/error, update cards live ──
  async function pollJob(job) {
    var maxPolls = 60;   // 60 × 3s = 3 minutes max per doc
    for (var p = 0; p < maxPolls; p++) {
      await new Promise(function(r){ setTimeout(r, 3000); });
      try {
        var s = await fetch(API_BASE + '/api/matescale/documents/job/' + job.jobId).then(function(r){ return r.json(); });
        var meta = _docMeta.find(function(d){ return d.path === job.path; });
        if (s.status === 'done') {
          if (meta) {
            meta.extracting = false; meta.extracted = true;
            meta.nodes = s.nodes; meta.edges = s.edges;
            meta.clause_risk = s.clause_risk || null;
            meta.heat_map    = s.heat_map    || null;
            meta.images      = s.images      || null;
          }
          renderDocList();
          _renderClauseRisk(meta);
          if (meta && meta.images) _renderImageGrid(meta.images);
          // Render KG graph from saved graph edges
          try {
            var graphResp = await fetch(API_BASE + '/api/matescale/documents/graph-edges?path=' + encodeURIComponent(job.path)).then(function(r){ return r.json(); });
            if (graphResp.edges && graphResp.edges.length) {
              $id('dc-kg').textContent = graphResp.edges.length;
              setTimeout(function(){ buildDocKGGraph(graphResp.edges); }, 80);
            }
          } catch(e) { /* graph load optional */ }
          return 'done';
        } else if (s.status === 'error') {
          if (meta) { meta.extracting = false; meta.error = s.error; }
          renderDocList();
          return 'error';
        }
        // still queued/extracting/embedding — update label
        if (meta) { meta.jobStatus = s.status; }
        renderDocList();
      } catch(e) { /* network hiccup, keep polling */ }
    }
    return 'timeout';
  }

  // Poll all jobs in parallel
  var results = await Promise.all(jobs.map(pollJob));
  var doneCount = results.filter(function(r){ return r === 'done'; }).length;
  status.textContent = '✅ ' + doneCount + '/' + jobs.length + ' doc(s) indexed — ready to ask';
  loadSuggestedQuestions();
}

// ── Clause Risk Panel ─────────────────────────────────────────────────────
var _clauseRiskRendered = {};
function _renderClauseRisk(meta) {
  if (!meta || !meta.clause_risk) return;
  var risk = meta.clause_risk;
  if (!risk.findings || !risk.findings.length) return;
  if (_clauseRiskRendered[meta.name]) return; // only once per doc
  _clauseRiskRendered[meta.name] = true;

  var hist = $id('qa-history');
  var severityColor = { CRITICAL: '#dc2626', HIGH: '#d97706', MEDIUM: '#2563eb' };
  var severityBg    = { CRITICAL: '#fef2f2', HIGH: '#fffbeb', MEDIUM: '#eff6ff' };

  var rows = risk.findings.map(function(f) {
    var c = severityColor[f.severity] || '#6b7280';
    var bg = severityBg[f.severity] || '#f9fafb';
    return '<div style="display:flex;gap:8px;align-items:flex-start;padding:6px 8px;border-radius:6px;background:' + bg + ';margin-bottom:4px;">' +
      '<span style="color:' + c + ';font-weight:700;font-size:10px;min-width:58px;padding-top:1px;">' + f.severity + '</span>' +
      '<div style="flex:1;">' +
        '<div style="font-weight:600;font-size:12px;color:#1e293b;">' + f.clause + '</div>' +
        '<div style="font-size:11px;color:#64748b;">' + f.clause_ref + ' — S.' + f.page + '</div>' +
        '<div style="font-size:11px;color:#374151;margin-top:2px;">' + f.impact + '</div>' +
      '</div>' +
    '</div>';
  }).join('');

  // Heat map summary
  var hm = meta.heat_map;
  var hmHtml = '';
  if (hm && hm.dissonance_zones && hm.dissonance_zones.length) {
    hmHtml = '<div style="margin-top:8px;padding:6px 8px;background:#fdf4ff;border-radius:6px;border-left:3px solid #9333ea;">' +
      '<div style="font-weight:700;font-size:11px;color:#7e22ce;margin-bottom:4px;">⚡ Konfliktklauseln (' + hm.dissonance_zones.length + ')</div>' +
      hm.dissonance_zones.slice(0,5).map(function(z) {
        return '<div style="font-size:11px;color:#581c87;padding:2px 0;">S.' + z.page + ' — ' + (z.heading || 'Abschnitt') + '</div>';
      }).join('') +
    '</div>';
  }

  var riskLabel = { CRITICAL: '🔴', HIGH: '🟡', MEDIUM: '🔵', LOW: '🟢' };
  var dot = riskLabel[risk.risk_level] || '⚪';
  var el = document.createElement('div');
  el.style.cssText = 'margin:8px 0;padding:10px 12px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;';
  el.innerHTML =
    '<div style="font-weight:700;font-size:12px;color:#1e293b;margin-bottom:8px;">' +
      dot + ' Klausel-Screening — <em>' + meta.name + '</em>' +
      ' <span style="font-weight:400;font-size:11px;color:#64748b;">(' + risk.total + ' Klauseln erkannt)</span>' +
    '</div>' +
    rows + hmHtml;
  hist.appendChild(el);
  hist.scrollTop = hist.scrollHeight;
}

function _renderImageGrid(images) {
  if (!images || !images.details || !images.details.length) return;
  var grid = $id('dc-img-grid');
  var cnt  = $id('dc-images');
  if (!grid) return;
  if (cnt) cnt.textContent = images.total_embedded;
  var dsImg = $id('ds-images');
  if (dsImg) dsImg.textContent = images.total_embedded;
  var dsPages = $id('ds-imgpages');
  if (dsPages) dsPages.textContent = (images.pages_with_images || 0) + ' pages';
  grid.innerHTML = images.details.map(function(img) {
    var mp = img.width && img.height ? ((img.width * img.height) / 1e6).toFixed(1) + 'MP' : '';
    return '<div class="doc-img-card">' +
      '<img src="' + API_BASE + '/extracted-images/' + img.filename +
        '" loading="lazy" onerror="this.style.display=\'none\';this.nextSibling.style.display=\'flex\'">' +
      '<div class="no-prev" style="display:none;align-items:center;justify-content:center;height:72px;color:var(--muted);font-size:18px;">📄</div>' +
      '<div class="meta">S.' + img.page + ' · ' + img.width + '×' + img.height + (mp ? ' · ' + mp : '') + '</div>' +
    '</div>';
  }).join('');
}

function _renderTruthGaps(tg) {
  if (!tg || !tg.gaps || !tg.gaps.length) return;
  var hist = $id('qa-history');
  var rows = tg.gaps.slice(0, 8).map(function(g) {
    var c = g.severity === 'critical' ? '#dc2626' : '#d97706';
    var bg = g.severity === 'critical' ? '#fef2f2' : '#fffbeb';
    return '<div style="padding:5px 8px;border-radius:6px;background:' + bg + ';margin-bottom:3px;font-size:11px;">' +
      '<span style="color:' + c + ';font-weight:700;">' + g.spread_pct + '% Abweichung</span> — ' +
      '<strong>' + g.value_a + '</strong> (' + g.doc_a + ', S.' + g.page_a + ') vs ' +
      '<strong>' + g.value_b + '</strong> (' + g.doc_b + ', S.' + g.page_b + ')' +
      (g.heading_a ? '<div style="color:#94a3b8;margin-top:1px;">' + g.heading_a + '</div>' : '') +
    '</div>';
  }).join('');
  var el = document.createElement('div');
  el.style.cssText = 'margin:6px 0;padding:10px 12px;background:#f8fafc;border:1px solid #fca5a5;border-radius:10px;';
  el.innerHTML =
    '<div style="font-weight:700;font-size:12px;color:#991b1b;margin-bottom:7px;">' +
      '⚔ Widerspruchs-Analyse — ' + tg.docs_analyzed + ' Dokumente · ' +
      tg.total_gaps + ' Konflikt' + (tg.total_gaps !== 1 ? 'e' : '') +
      (tg.critical_gaps ? ' (' + tg.critical_gaps + ' kritisch)' : '') +
    '</div>' + rows;
  hist.appendChild(el);
  hist.scrollTop = hist.scrollHeight;
}

function qaAppendMsg(role, text, sources, ampelData) {
  var hist = $id('qa-history');
  var isUser = role === 'user';
  var bubble = document.createElement('div');
  bubble.style.cssText = 'display:flex;flex-direction:column;align-items:' + (isUser ? 'flex-end' : 'flex-start') + ';gap:3px;';
  var inner = document.createElement('div');
  inner.style.cssText = 'max-width:85%;padding:8px 12px;border-radius:10px;font-size:12px;line-height:1.5;white-space:pre-wrap;word-break:break-word;background:' +
    (isUser ? 'var(--accent);color:var(--navy)' : 'var(--bg);color:var(--text);border:1px solid var(--border)');
  inner.textContent = text;
  bubble.appendChild(inner);
  if (sources && sources.length) {
    var srcRow = document.createElement('div');
    srcRow.style.cssText = 'display:flex;flex-wrap:wrap;gap:4px;padding:2px 4px;';
    var _originIcon = { section:'📄', table:'📊', image:'🖼️', stamp:'🔏', signature:'✍️' };
    var _originColor = { section:'var(--blue)', table:'#7c3aed', image:'#d97706', stamp:'#64748b', signature:'#64748b' };
    sources.forEach(function(s) {
      var otype = s.origin_type || 'section';
      var icon  = _originIcon[otype]  || '📄';
      var color = _originColor[otype] || 'var(--blue)';
      var chip = document.createElement('button');
      chip.style.cssText = 'background:var(--bg);border:1px solid var(--border);border-radius:5px;' +
        'padding:2px 7px;font-size:10px;color:' + color + ';cursor:pointer;' +
        'display:inline-flex;align-items:center;gap:3px;transition:background 0.12s;';
      chip.innerHTML = icon + ' <span style="color:var(--muted);font-size:9px;text-transform:uppercase;letter-spacing:.5px;">' + otype + '</span>' +
        ' <span>' + s.doc + ' p.' + s.page + '</span>';
      chip.title = (s.heading || 'View source') + '\nOrigin: ' + otype;
      chip.onmouseenter = function(){ this.style.background='var(--blue-soft)'; };
      chip.onmouseleave = function(){ this.style.background='var(--bg)'; };
      chip.onclick = function(){ openSourceModal(s); };
      srcRow.appendChild(chip);
    });
    bubble.appendChild(srcRow);
  }
  // ── Ampel (traffic light) ─────────────────────────────────────────────────
  if (ampelData && !isUser) {
    var ampelColors = {red:'#dc2626', yellow:'#d97706', green:'#16a34a'};
    var ampelEmoji  = {red:'🔴', yellow:'🟡', green:'🟢'};
    var color = ampelColors[ampelData.ampel] || '#6b7280';
    var dot   = ampelEmoji[ampelData.ampel]  || '⚪';
    var badge = document.createElement('div');
    badge.style.cssText = 'font-size:10px;padding:4px 8px;border-radius:6px;border:1px solid ' + color + ';color:' + color + ';max-width:85%;line-height:1.4;';
    badge.innerHTML = dot + ' <strong>' + (ampelData.ampel || 'unknown').toUpperCase() + '</strong> — ' + (ampelData.ampel_reason || '');
    bubble.appendChild(badge);
    // Show each contradiction explicitly
    if (ampelData.contradictions && ampelData.contradictions.length) {
      ampelData.contradictions.forEach(function(c) {
        var row = document.createElement('div');
        row.style.cssText = 'font-size:10px;color:#dc2626;padding:2px 4px;max-width:85%;';
        row.textContent = '⚠ "' + c.claim + '" vs KG: ' + c.edge + (c.page ? ' (p.' + c.page + ')' : '');
        bubble.appendChild(row);
      });
    }
    // ── Jury / Panel / Adversarial output ────────────────────────────────
    if (ampelData.critic) {
      var c = ampelData.critic;
      var isPanel = c.mode === 'panel';
      var isJury  = !isPanel && c.model && c.model.startsWith('jury:');
      var jAmpel  = c.jury_ampel || 'yellow';
      var ampelBg  = {green:'#f0fdf4', yellow:'#fffbeb', red:'#fef2f2'};
      var ampelBdr = {green:'#bbf7d0', yellow:'#fde68a', red:'#fecaca'};
      var ampelTxt = {green:'#15803d', yellow:'#92400e', red:'#991b1b'};
      var bgC  = ampelBg[jAmpel]  || '#fffbeb';
      var bdrC = ampelBdr[jAmpel] || '#fde68a';
      var txtC = ampelTxt[jAmpel] || '#92400e';

      var _esc = function(s){ return (s||'').replace(/</g,'&lt;').replace(/>/g,'&gt;'); };
      var _chain = function(steps){ return steps && steps.length ? steps.map(function(s,i){return '<span style="color:#6b7280;">'+_esc(s)+'</span>';}).join('<br>→ ') : ''; };

      if (isPanel && c.experts) {
        var expertColors = { bauleiter:'#b45309', jurist:'#1d4ed8', bim_koordinator:'#0e7490', auftraggeber:'#7c3aed', kalkulator:'#065f46' };
        var panelBox = document.createElement('div');
        panelBox.style.cssText = 'margin-top:8px;max-width:97%;border:1px solid ' + bdrC + ';border-radius:10px;overflow:hidden;font-size:11px;';

        var ph = '<div style="background:' + bgC + ';padding:8px 12px;font-weight:700;color:' + txtC + ';display:flex;justify-content:space-between;align-items:center;">' +
          '<span>🏛 Expertenpanel — ' + _esc(c.verdict||'') + '</span>' +
          '<span style="font-size:10px;">' + (c.model||'') + ' · ' + Math.round((c.confidence||0)*100) + '% Konfidenz</span>' +
        '</div>';
        if (c.key_finding) ph += '<div style="padding:6px 12px;background:#f8fafc;border-top:1px solid #e5e7eb;color:#374151;">' +
          '<strong>Kernbefund:</strong> ' + _esc(c.key_finding).slice(0,300) + '</div>';
        if (c.reasoning) ph += '<div style="padding:5px 12px;background:#f1f5f9;border-top:1px solid #e5e7eb;font-size:10px;color:#475569;">' +
          '<strong>Reasoning:</strong> ' + _esc(c.reasoning).slice(0,300) + '</div>';
        if (c.memory_impact) ph += '<div style="padding:5px 12px;background:#eff6ff;border-top:1px solid #bfdbfe;font-size:10px;color:#1d4ed8;">' +
          '🧠 <strong>Memory-Einfluss:</strong> ' + _esc(c.memory_impact).slice(0,250) + '</div>';

        var expRows = '';
        Object.keys(c.experts).forEach(function(eid) {
          var op = c.experts[eid] || {};
          var ec = expertColors[eid] || '#6b7280';
          var icon = op.icon || '👤';
          var name = op.name || eid;
          var conf = op.confidence ? Math.round(op.confidence*100)+'%' : '';
          var chain = _chain(op.reasoning_chain);
          var flags = op.flags && op.flags.length ? op.flags.map(function(f){ return '⚠ '+_esc(f); }).join(' · ') : '';
          var evidence = op.evidence_quotes && op.evidence_quotes.length ? '"' + _esc(op.evidence_quotes[0]).slice(0,120) + '"' : '';

          expRows += '<details style="border-top:1px solid #e5e7eb;">' +
            '<summary style="padding:6px 12px;cursor:pointer;display:flex;align-items:center;gap:8px;">' +
              '<span style="color:' + ec + ';font-weight:700;">' + icon + ' ' + name + '</span>' +
              '<span style="flex:1;color:#374151;font-size:10px;">' + _esc(op.opinion||'').slice(0,120) + '…</span>' +
              (conf ? '<span style="font-size:10px;color:#6b7280;">'+conf+'</span>' : '') +
            '</summary>' +
            '<div style="padding:8px 14px 10px;background:#f9fafb;font-size:10px;line-height:1.6;">' +
              '<div style="margin-bottom:6px;color:#374151;">' + _esc(op.opinion||'') + '</div>' +
              (chain ? '<div style="margin-bottom:6px;padding:6px 8px;background:#f1f5f9;border-radius:4px;border-left:3px solid '+ec+';">' +
                '<strong style="color:'+ec+';">Reasoning:</strong><br>' + chain + '</div>' : '') +
              (evidence ? '<div style="margin-bottom:4px;padding:5px 8px;background:#fffbeb;border-radius:4px;font-style:italic;color:#92400e;">' + evidence + '</div>' : '') +
              (flags ? '<div style="color:#dc2626;">' + flags + '</div>' : '') +
            '</div>' +
          '</details>';
        });

        var footer = '';
        if (c.corrections && c.corrections.length) footer +=
          '<div style="padding:5px 12px;border-top:1px solid #fecaca;background:#fef2f2;font-size:10px;color:#991b1b;"><strong>Korrekturen:</strong> ' + c.corrections.map(_esc).join(' · ') + '</div>';
        if (c.confirmed_points && c.confirmed_points.length) footer +=
          '<div style="padding:5px 12px;border-top:1px solid #bbf7d0;background:#f0fdf4;font-size:10px;color:#15803d;"><strong>Bestätigt:</strong> ' + c.confirmed_points.map(_esc).join(' · ') + '</div>';
        if (c.conflicts && c.conflicts.length) footer +=
          '<div style="padding:5px 12px;border-top:1px solid #fde68a;background:#fffbeb;font-size:10px;color:#92400e;"><strong>Widersprüche:</strong> ' + c.conflicts.map(_esc).join(' · ') + '</div>';

        panelBox.innerHTML = ph + expRows + footer;
        bubble.appendChild(panelBox);

      } else if (isJury || c.mode === 'jury') {
        var juryBox = document.createElement('div');
        juryBox.style.cssText = 'margin-top:6px;max-width:97%;border:1px solid ' + bdrC + ';border-radius:8px;overflow:hidden;font-size:11px;';
        var jh = '<div style="background:' + bgC + ';padding:6px 12px;font-weight:700;color:' + txtC + ';display:flex;justify-content:space-between;">' +
          '<span>⚔ Construction Jury</span>' +
          '<span style="font-size:10px;">' + (c.model||'') + ' · ' + Math.round((c.confidence||0)*100) + '% confidence</span>' +
        '</div>';
        if (c.memory_impact) jh += '<div style="padding:4px 12px;background:#eff6ff;border-top:1px solid #bfdbfe;font-size:10px;color:#1d4ed8;">🧠 ' + _esc(c.memory_impact).slice(0,200) + '</div>';

        var jrows = '';
        if (c.assassin) jrows +=
          '<details style="border-top:1px solid #e5e7eb;">' +
            '<summary style="padding:5px 12px;cursor:pointer;"><span style="color:#dc2626;font-weight:600;">🏗 Bauleiter (Angriff):</span> ' + _esc(c.assassin).slice(0,100) + '…</summary>' +
            '<div style="padding:6px 14px 8px;background:#fef9f9;font-size:10px;">' +
              '<div style="margin-bottom:5px;">' + _esc(c.assassin) + '</div>' +
              (c.assassin_reasoning && c.assassin_reasoning.length ? '<div style="padding:5px 8px;background:#f1f5f9;border-radius:4px;border-left:3px solid #dc2626;margin-bottom:4px;"><strong>Reasoning:</strong><br>' + _chain(c.assassin_reasoning) + '</div>' : '') +
              (c.assassin_flags && c.assassin_flags.length ? '<div style="color:#dc2626;">⚠ ' + c.assassin_flags.map(_esc).join(' · ') + '</div>' : '') +
            '</div>' +
          '</details>';
        if (c.defender) jrows +=
          '<details style="border-top:1px solid #e5e7eb;">' +
            '<summary style="padding:5px 12px;cursor:pointer;"><span style="color:#2563eb;font-weight:600;">⚖️ Jurist (Verteidigung):</span> ' + _esc(c.defender).slice(0,100) + '…</summary>' +
            '<div style="padding:6px 14px 8px;background:#f0f7ff;font-size:10px;">' +
              '<div style="margin-bottom:5px;">' + _esc(c.defender) + '</div>' +
              (c.defender_reasoning && c.defender_reasoning.length ? '<div style="padding:5px 8px;background:#f1f5f9;border-radius:4px;border-left:3px solid #2563eb;margin-bottom:4px;"><strong>Reasoning:</strong><br>' + _chain(c.defender_reasoning) + '</div>' : '') +
              (c.defender_evidence && c.defender_evidence.length ? '<div style="font-style:italic;color:#1d4ed8;">"' + _esc(c.defender_evidence[0]).slice(0,150) + '"</div>' : '') +
            '</div>' +
          '</details>';
        if (c.critique) jrows +=
          '<div style="padding:6px 12px;border-top:1px solid #e5e7eb;background:' + bgC + ';">' +
            '<span style="color:' + txtC + ';font-weight:600;">🏛 Richter:</span> ' + _esc(c.critique) +
            (c.judge_reasoning ? '<div style="margin-top:4px;font-size:10px;color:#475569;"><strong>Reasoning:</strong> ' + _esc(c.judge_reasoning).slice(0,250) + '</div>' : '') +
          '</div>';

        juryBox.innerHTML = jh + jrows;
        bubble.appendChild(juryBox);

      } else {
        // Single critic fallback
        var criticBox = document.createElement('div');
        criticBox.style.cssText = 'margin-top:4px;max-width:85%;padding:6px 10px;border-radius:6px;font-size:10px;line-height:1.5;border:1px solid ' + bdrC + ';background:' + bgC + ';color:' + txtC + ';';
        criticBox.innerHTML = '<strong>⚔ Critic (' + (c.model||'?') + '):</strong> ' + (c.critique||'').replace(/</g,'&lt;').replace(/>/g,'&gt;');
        bubble.appendChild(criticBox);
      }
    }
  }
  hist.appendChild(bubble);
  hist.scrollTop = hist.scrollHeight;
}

function qaAsk(q) {
  $id('qa-input').value = q;
  sendDocQuestion();
}

async function loadSuggestedQuestions() {
  if (!_uploadedPdfPaths.length) return;
  var label = $id('qa-suggest-label');
  if (label) { label.textContent = '⏳ Generating questions…'; }
  try {
    var data = await fetch(API_BASE + '/api/matescale/documents/suggest-questions', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({pdf_paths: _uploadedPdfPaths})
    }).then(function(r){ return r.json(); });

    var sugg = $id('qa-suggestions');
    sugg.innerHTML = '';
    if (data.questions && data.questions.length) {
      var lbl = document.createElement('span');
      lbl.id = 'qa-suggest-label';
      lbl.style.cssText = 'font-size:11px;color:var(--muted);width:100%;margin-bottom:2px;';
      lbl.textContent = 'Suggested for you:';
      sugg.appendChild(lbl);
      data.questions.forEach(function(q) {
        var btn = document.createElement('button');
        btn.className = 'qa-chip';
        btn.textContent = q;
        btn.onclick = function(){ qaAsk(q); };
        sugg.appendChild(btn);
      });
    }
  } catch(e) {
    var label2 = $id('qa-suggest-label');
    if (label2) label2.textContent = 'Ask anything about your documents:';
  }
}

async function sendDocQuestion() {
  var input = $id('qa-input');
  var q = input.value.trim();
  if (!q) return;
  // hide suggestion chips once first question is asked
  var sugg = $id('qa-suggestions');
  if (sugg) sugg.style.display = 'none';
  if (!_uploadedPdfPaths.length) {
    qaAppendMsg('assistant', '⚠ No documents loaded — upload a PDF and click Extract first.', null);
    return;
  }
  input.value = '';
  qaAppendMsg('user', q, null);

  // Thinking indicator
  var hist = $id('qa-history');
  var thinking = document.createElement('div');
  thinking.id = 'qa-thinking';
  thinking.style.cssText = 'font-size:11px;color:var(--muted);padding:4px 0;';
  thinking.textContent = '⏳ Reading documents…';
  hist.appendChild(thinking);
  hist.scrollTop = hist.scrollHeight;

  var adversarial  = !!($id('qa-adversarial-toggle') && $id('qa-adversarial-toggle').checked);
  var usePanel     = !!($id('qa-panel-toggle')       && $id('qa-panel-toggle').checked);
  var selectedModel = ($id('qa-model-select') || {}).value || 'mistral-small:24b';
  if (usePanel)         thinking.textContent = '⏳ Expertenpanel läuft (6 Rollen · ~60s)…';
  else if (adversarial) thinking.textContent = '⏳ Jury läuft (3 Agenten · ~40s)…';
  else                  thinking.textContent = '⏳ Lese Dokumente (' + selectedModel + ')…';
  $id('qa-send-btn').disabled = true;
  var _qaTimeout = adversarial || usePanel ? 240000 : 120000;
  var _qaAbort = new AbortController();
  var _qaTimer = setTimeout(function(){ _qaAbort.abort(); }, _qaTimeout);
  try {
    var data = await fetch(API_BASE + '/api/matescale/documents/qa', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      signal: _qaAbort.signal,
      body: JSON.stringify({
        question: q, pdf_paths: _uploadedPdfPaths,
        adversarial: adversarial, panel: usePanel,
        generator_model: selectedModel
      })
    }).then(function(r){ return r.json(); });
    clearTimeout(_qaTimer);
    thinking.remove();
    // Show retrieval method + model badge
    var badge = $id('qa-retrieval-badge');
    if (badge && data.retrieval_method) {
      badge.style.display = 'inline';
      var rm = data.retrieval_method || '';
      var mdl = data.generator_model ? ' · ' + data.generator_model : '';
      badge.textContent = (rm === 'rrf+reranker' ? '🎯 RRF + reranker' : rm === 'rrf+bm25' ? '🔀 RRF + BM25' : '📝 bm25') + mdl;
      badge.style.background = rm === 'rrf+reranker' ? '#f0fdf4' : rm === 'rrf+bm25' ? '#e8edff' : '#fef3c7';
      badge.style.color = rm === 'rrf+reranker' ? '#15803d' : rm === 'rrf+bm25' ? '#3b5bdb' : '#d97706';
    }
    qaAppendMsg('assistant', data.answer || 'No answer returned.', data.sources, data);
    // Truth Gap panel — only shown when 2+ docs and gaps found
    if (data.truth_gaps && data.truth_gaps.total_gaps > 0) {
      _renderTruthGaps(data.truth_gaps);
    }
  } catch(e) {
    clearTimeout(_qaTimer);
    thinking.remove();
    var msg = e.name === 'AbortError'
      ? '⏱ Timeout — das Modell hat zu lang gebraucht. Versuche ohne Jury, oder wähle llama3.2:3b als Modell.'
      : '⚠ Error: ' + e.message;
    qaAppendMsg('assistant', msg, null);
  }
  $id('qa-send-btn').disabled = false;
  $id('qa-input').focus();
}

async function runMultiExtraction() {
  var btn = $id('doc-multi-btn');
  var status = $id('doc-extract-status');
  btn.disabled = true; btn.textContent = '⏳ Merging…';
  try {
    var data = await fetch(API_BASE + '/api/matescale/documents/extract-multi', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({pdf_paths: _uploadedPdfPaths})
    }).then(function(r) { return r.json(); });

    // Show unified KG graph
    buildDocKGGraph(data.unified_kg || []);

    // Update stats
    $id('ds-rels').textContent = data.total_edges;
    $id('ds-kg').textContent = data.total_edges;

    // Cross-doc correlation badge
    var crossCount = data.cross_matches_count || 0;
    status.textContent = '✓ ' + data.documents.length + ' docs merged · ' + data.total_edges + ' edges · ' + crossCount + ' shared concepts';

    // Show doc summary in text panel
    var docSummary = (data.documents || []).map(function(d) {
      return '<div style="padding:6px 0;border-bottom:1px solid var(--border);font-size:12px;">' +
        '<strong style="color:var(--blue);">' + d.filename + '</strong><br>' +
        '<span style="color:var(--muted);">Pages: ' + d.pages + ' · KG edges: ' + d.kg_rels + '</span></div>';
    }).join('');
    if (crossCount > 0) {
      docSummary += '<div style="padding:6px;margin-top:6px;background:#ede9fe;border-radius:6px;font-size:11px;color:#5b21b6;">🔗 ' + crossCount + ' shared concepts found across documents</div>';
    }
    $id('dc-text-blocks').innerHTML = docSummary;
  } catch(e) {
    status.textContent = '⚠ ' + e.message;
  }
  btn.disabled = false; btn.textContent = '🔗 Unified Graph';
}

async function runRealExtraction() {
  var btn = $id('doc-extract-btn');
  var status = $id('doc-extract-status');
  btn.disabled = true;
  btn.textContent = '⏳ Extracting…';
  status.textContent = 'Reading PDF…';

  var labels = ['Reading PDF…', 'Extracting images…', 'Analysing diagrams…', 'Building KG…', 'Rendering…'];
  var li = 0;
  var ticker = setInterval(function() { if (li < labels.length) status.textContent = labels[li++]; }, 600);

  var url = API_BASE + '/api/matescale/documents/extract-real';
  var activePath = (_docMeta.length && _docMeta[_activeDocIdx] ? _docMeta[_activeDocIdx].path : null) || (_uploadedPdfPaths && _uploadedPdfPaths[0]);
  if (activePath) url += '?pdf_path=' + encodeURIComponent(activePath);

  try {
    var data = await fetch(url).then(function(r) { return r.json(); });
    clearInterval(ticker);
    if (data.error) { status.textContent = 'Error: ' + data.error; btn.disabled = false; btn.textContent = '🔬 Extract'; return; }

    var t = data.topography;
    var d = data.diagram_analysis;
    var imgs = data.images || { total_embedded: 0, pages_with_images: 0, details: [] };
    var rels = data.kg_relationships || [];

    // Stat bar
    $id('ds-pages').textContent = t.pages;
    $id('ds-blocks').textContent = t.total_text_blocks.toLocaleString();
    $id('ds-images').textContent = imgs.total_embedded || 0;
    $id('ds-imgpages').textContent = (imgs.pages_with_images || 0) + ' pages';
    $id('ds-vectors').textContent = d.total_vector_elements.toLocaleString();
    $id('ds-rels').textContent = d.total_relationships.toLocaleString();
    $id('ds-kg').textContent = d.kg_edges_generated.toLocaleString();
    $id('ds-stamps').textContent = (t.stamps_detected + t.tables_detected);

    // Panel counts
    $id('dc-blocks').textContent = t.total_text_blocks;
    $id('dc-images').textContent = imgs.total_embedded || 0;
    $id('dc-kg').textContent = d.kg_edges_generated;
    $id('dc-diag').textContent = d.pages_with_structure + ' pages';
    $id('dc-tables').textContent = (t.tables || []).length;

    // Text blocks
    $id('dc-text-list').innerHTML = (t.sample_blocks || []).map(function(b) {
      return '<div class="doc-tb' + (b.is_bold ? ' is-bold' : '') + '">' +
        '<span class="pg">p' + b.page + '</span>' +
        (b.font_size ? '<span class="sz">' + b.font_size + 'pt</span>' : '') +
        '<span class="content">' + b.text + '</span></div>';
    }).join('') || '<span style="color:var(--muted);">No text blocks</span>';

    // Image thumbnails
    var details = imgs.details || [];
    $id('dc-img-grid').innerHTML = details.length
      ? details.map(function(img) {
          var fname = img.filename || '';
          var mp = ((img.width * img.height) / 1e6).toFixed(1);
          return '<div class="doc-img-card">' +
            '<img src="' + API_BASE + '/extracted-images/' + fname + '" onerror="this.style.display=\'none\';this.nextSibling.style.display=\'flex\'">' +
            '<div class="no-prev" style="display:none;">📄 vector</div>' +
            '<div class="meta">p' + img.page + ' · ' + img.width + '×' + img.height + ' · ' + mp + 'MP</div>' +
            '</div>';
        }).join('')
      : '<div style="color:var(--muted);font-size:12px;padding:8px;">No embedded images</div>';

    // KG graph
    setTimeout(function() { buildDocKGGraph(rels); }, 80);
    var namedRels = rels.filter(function(r) { return !r.source.startsWith('box_') && !r.target.startsWith('box_'); });
    $id('dc-named').textContent = namedRels.length + ' named';

    // Named relationships list
    $id('dc-named-list').innerHTML = namedRels.length
      ? namedRels.map(function(r) {
          return '<div class="doc-kg-rel">' +
            '<span class="doc-kg-method">' + r.method + '</span>' +
            '<span class="doc-kg-nodes"><strong>' + r.source + '</strong> → <strong>' + r.target + '</strong></span>' +
            '<span style="color:var(--muted);font-size:9px;white-space:nowrap;">p' + r.page + '</span></div>';
        }).join('')
      : '<div style="color:var(--muted);font-size:12px;padding:8px;">No named relationships found</div>';

    // Diagram structure per page
    $id('dc-diag-list').innerHTML = (d.pages || []).map(function(pg) {
      return '<div class="doc-diag-row">' +
        '<span class="doc-diag-pg">p' + pg.page + '</span>' +
        '<span class="doc-diag-bar" style="background:#e0e7ff;color:#4338ca;">' + pg.boxes + ' boxes</span>' +
        '<span class="doc-diag-bar" style="background:#fce7f3;color:#be185d;">' + pg.lines + ' lines</span>' +
        '<span class="doc-diag-bar" style="background:#d1fae5;color:#065f46;">' + pg.relationships + ' rels</span>' +
        '<span style="font-size:9px;color:var(--muted);">' + (pg.methods || []).join(' · ') + '</span></div>';
    }).join('') || '<div style="color:var(--muted);font-size:12px;">No diagram pages</div>';

    // Tables
    var tables = t.tables || [];
    $id('dc-table-list').innerHTML = tables.length
      ? tables.map(function(tb) {
          var rows = tb.rows || [tb.content_sample || ''];
          return '<div style="margin-bottom:12px;border:1px solid var(--border);border-radius:7px;overflow:hidden;">' +
            '<div style="background:var(--navy);color:#fff;padding:5px 8px;font-size:10px;font-weight:700;">📊 p' + tb.page + ' — ' + (tb.title || 'Table').substring(0, 50) + '</div>' +
            rows.map(function(r, i) {
              return '<div style="padding:3px 8px;font-size:10px;' + (i === 0 ? 'font-weight:700;background:#f0f4ff;' : '') + 'border-bottom:1px solid var(--border);">' + r.substring(0, 100) + '</div>';
            }).join('') + '</div>';
        }).join('')
      : '<div style="color:var(--muted);font-size:12px;padding:8px;">No tables detected</div>';

    status.textContent = '✅ Done in ' + data.processing_time_sec + 's · ' + data.filename;
    btn.disabled = false;
    btn.textContent = '🔬 Extract';
    loadSuggestedQuestions();
  } catch(e) {
    clearInterval(ticker);
    status.textContent = 'Error: ' + e.message;
    btn.disabled = false;
    btn.textContent = '🔬 Extract';
  }
}

async function runDocProcessorDemo() {
  loading('doc-result', 'Processing PDFs and images...');
  try {
    var data = await fetch('/api/matescale/documents/demo').then(function(r){return r.json();});
    $id('doc-results').style.display = 'block';

    // Summary stats
    var summary = data.summary;
    var statsHtml = '<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:12px;">' +
      '<div style="background:var(--blue-soft);border:1px solid var(--border);border-radius:8px;padding:12px;">' +
        '<div style="font-weight:700;color:var(--blue);">' + summary.pdfs_successful + '</div>' +
        '<div style="font-size:11px;color:var(--muted);">PDFs Processed</div>' +
      '</div>' +
      '<div style="background:#e0e7ff;border:1px solid var(--border);border-radius:8px;padding:12px;">' +
        '<div style="font-weight:700;color:#4f46e5;">' + summary.unique_images + '/' + summary.total_images + '</div>' +
        '<div style="font-size:11px;color:var(--muted);">Unique Images ('+Math.round(summary.savings_pct)+'% saved)</div>' +
      '</div>' +
      '<div style="background:#f0fdf4;border:1px solid var(--border);border-radius:8px;padding:12px;">' +
        '<div style="font-weight:700;color:var(--green);">' + summary.total_defects_detected + '</div>' +
        '<div style="font-size:11px;color:var(--muted);">Defects Detected</div>' +
      '</div>' +
    '</div>';
    $id('doc-stats').innerHTML = statsHtml;

    // PDF results
    var pdfHtml = '<div style="background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:12px;">' +
      '<div style="font-weight:700;color:var(--navy);margin-bottom:8px;">📑 PDF Topography</div>';
    data.pdfs.forEach(function(pdf) {
      pdfHtml += '<div style="font-size:12px;margin-bottom:8px;padding-bottom:8px;border-bottom:1px solid var(--border);color:var(--text);">' +
        '<strong>' + pdf.filename + '</strong><br/>' +
        '<span style="color:var(--muted);">Pages: ' + pdf.pages + ' • Blocks: ' + pdf.block_count + ' • Stamps: ' + pdf.stamp_count + '</span>';
      if (pdf.amendments.length) {
        pdfHtml += '<br/><span style="color:#ea580c;font-size:11px;">Amendments: ' + pdf.amendments.map(function(a) { return a.revision; }).join(', ') + '</span>';
      }
      pdfHtml += '</div>';
    });
    pdfHtml += '</div>';
    $id('doc-pdf-results').innerHTML = pdfHtml;

    // Image dedup results
    var imgHtml = '<div style="background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:12px;">' +
      '<div style="font-weight:700;color:var(--navy);margin-bottom:8px;">🔍 Image Deduplication</div>' +
      '<div style="font-size:12px;margin-bottom:8px;color:var(--text);">' +
        summary.total_images + ' images → ' + summary.unique_images + ' unique (' + Math.round(summary.savings_pct) + '% saved)' +
      '</div>';
    data.images.deduplication.fingerprints.forEach(function(fp) {
      if (!fp.is_duplicate) {
        imgHtml += '<div style="font-size:11px;color:var(--muted);margin-bottom:4px;">✓ ' + fp.filename + '</div>';
      }
    });
    imgHtml += '</div>';
    $id('doc-image-results').innerHTML = imgHtml;

    // Defect analysis
    var defectHtml = '<div style="display:grid;grid-template-columns:1fr;gap:10px;">';
    data.images.defect_analysis.forEach(function(img) {
      if (img.has_defects) {
        defectHtml += '<div style="background:#fff5f5;border:1px solid #fecdd3;border-radius:8px;padding:12px;">' +
          '<div style="font-weight:700;color:var(--red);margin-bottom:6px;">⚠️ ' + img.filename + '</div>';
        img.detections.forEach(function(det) {
          defectHtml += '<div style="font-size:12px;color:var(--text);margin-bottom:4px;">' +
            '• ' + det.type.toUpperCase() + ' (' + Math.round(det.confidence*100) + '%) [' + det.signal + ']' +
          '</div>';
        });
        defectHtml += '</div>';
      }
    });
    defectHtml += '</div>';
    $id('doc-defects').innerHTML = defectHtml;

    setResult('doc-result', 'Pipeline complete!\n' + summary.pheromone_signals_generated + ' pheromone signals generated\n' + summary.amendments_detected + ' amendments detected for KG');
  } catch(e) { setResult('doc-result', 'Error: ' + e.message, true); }
}

async function runTopographyDemo() {
  loading('doc-result', 'Extracting PDF topography...');
  try {
    var data = await fetch('/api/matescale/documents/demo').then(function(r){return r.json();});
    var lines = ['📑 PDF TOPOGRAPHY EXTRACTION', ''];
    data.pdfs.forEach(function(pdf) {
      lines.push('File: ' + pdf.filename);
      lines.push('  Pages: ' + pdf.pages + ' • Text blocks: ' + pdf.block_count);
      lines.push('  Detected stamps: ' + pdf.stamp_count);
      if (pdf.amendments.length) {
        lines.push('  Amendments: ' + pdf.amendments.map(function(a) { return 'Rev ' + a.revision + ' (' + a.date + ')'; }).join(', '));
      }
      lines.push('');
    });
    setResult('doc-result', lines.join('\n'));
  } catch(e) { setResult('doc-result', 'Error: ' + e.message, true); }
}

async function runDeduplicationDemo() {
  loading('doc-result', 'Running image deduplication...');
  try {
    var data = await fetch('/api/matescale/documents/demo').then(function(r){return r.json();});
    var stats = data.images.deduplication;
    var lines = ['🔍 IMAGE DEDUPLICATION', '', stats.total + ' images → ' + stats.unique + ' unique'];
    lines.push('Savings: ' + Math.round(stats.savings_pct) + '% (removed ' + stats.duplicates + ' near-duplicates)');
    lines.push('');
    lines.push('Unique images retained:');
    stats.fingerprints.filter(function(f) { return !f.is_duplicate; }).forEach(function(fp) {
      lines.push('  ✓ ' + fp.filename);
    });
    lines.push('');
    lines.push('Duplicates skipped:');
    stats.fingerprints.filter(function(f) { return f.is_duplicate; }).forEach(function(fp) {
      lines.push('  ✗ ' + fp.filename + ' (' + Math.round(fp.similarity*100) + '% similar to ' + fp.duplicate_of + ')');
    });
    setResult('doc-result', lines.join('\n'));
  } catch(e) { setResult('doc-result', 'Error: ' + e.message, true); }
}

// ── D3 Graph ──────────────────────────────────────────────────────────────────
var NODE_C = {
  // 12-type construction ontology (v0.3 — Studio aligned)
  ACTOR:'#3b82f6', DOCUMENT:'#3b5bdb', PROCESS:'#f59e0b',
  MODEL:'#06b6d4', STANDARD_OR_RULE:'#8b5cf6', CONSTRAINT:'#ef4444',
  INFORMATION_REQUIREMENT:'#ec4899', DATA_ENVIRONMENT:'#6366f1',
  LIFECYCLE_PHASE:'#84cc16', CONCEPT:'#94a3b8',
  PROJECT:'#fb923c', ASSET:'#34d399', SOFTWARE_OR_TOOL:'#22d3ee',
  // Legacy / GAEB types
  COMPANY:'#0d7377', PERSON:'#7c3aed',
  GAEB_POSITION:'#f59e0b', VOB_PARAGRAPH:'#dc2626', VOB_SECTION:'#b91c1c',
  DIN_STANDARD:'#059669', CLAUSE:'#6366f1', FINANCIAL:'#0891b2',
  DATE:'#78716c', NACHTRAG:'#ea580c', ROLE:'#8b5cf6', DEFAULT:'#6b7280'
};

var EDGE_C = {
  // Hierarchical edges (Studio alignment — enables up-routing)
  parent_of:'#3b5bdb', sub_organization_of:'#6366f1', governed_by:'#8b5cf6',
  references:'#94a3b8',
  // Domain edges
  creates:'#10b981', produces:'#10b981', authors:'#10b981',
  must_comply_with:'#dc2626', is_checked_against:'#dc2626',
  is_executed_by:'#f59e0b', contains:'#84cc16',
  participates_in:'#3b82f6', manages:'#3b82f6',
  // Legacy
  amended_by:'#ea580c', contains_position:'#f59e0b',
  mentions:'#475569', regulated_by:'#059669', governed_by_vob:'#dc2626',
  inherits_clause:'#6366f1', shared_risk_interface:'#ec4899', DEFAULT:'#94a3b8'
};

function renderGraph(graph) {
  _kgData = graph;
  if (typeof d3 === 'undefined') {
    $id('kg-canvas').innerHTML = '<div style="color:#fc8181;padding:20px;text-align:center;">D3 not loaded — refresh page</div>';
    return;
  }

  // Top Nodes view — show ranked list instead of graph
  if (_kgView === 'top') {
    var sorted = graph.nodes.slice().sort(function(a,b){ return (b.confidence||0)-(a.confidence||0); });
    var html = '<div style="padding:20px;color:#e2e8f0;font-family:monospace;font-size:13px;">';
    html += '<div style="color:#8896b8;margin-bottom:12px;">Top nodes by confidence · click to focus</div>';
    sorted.slice(0,20).forEach(function(n,i){
      var col = NODE_C[n.type] || NODE_C.DEFAULT;
      html += '<div style="display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid #2d3748;cursor:pointer;" onclick="$id(\'kg-focus\').value=\''+n.name.replace(/'/g,'').slice(0,20)+'\';setKGView(\'entity\',document.getElementById(\'kt-entity\'));">' +
        '<span style="color:#8896b8;width:24px;">' + (i+1) + '</span>' +
        '<span style="width:10px;height:10px;border-radius:50%;background:'+col+';display:inline-block;flex-shrink:0;"></span>' +
        '<span style="flex:1;">' + (n.name||'').slice(0,40) + '</span>' +
        '<span style="color:#8896b8;font-size:11px;">' + (n.type||'') + '</span>' +
      '</div>';
    });
    html += '</div>';
    $id('kg-canvas').innerHTML = html;
    return;
  }

  var container = $id('kg-canvas');
  container.innerHTML = '';
  var W = container.offsetWidth || 800, H = 480;

  var svg = d3.select('#kg-canvas').append('svg')
    .attr('width', W).attr('height', H)
    .style('border-radius','10px');

  var defs = svg.append('defs');
  ['DEFAULT','governed_by_vob','regulated_by','inherits_clause','shared_risk_interface'].forEach(function(t) {
    defs.append('marker').attr('id','arr-'+t)
      .attr('viewBox','0 -5 10 10').attr('refX',18).attr('refY',0)
      .attr('markerWidth',5).attr('markerHeight',5).attr('orient','auto')
      .append('path').attr('d','M0,-5L10,0L0,5')
      .attr('fill', EDGE_C[t] || EDGE_C.DEFAULT).attr('opacity',0.7);
  });

  var g = svg.append('g');
  svg.call(d3.zoom().scaleExtent([0.2,4]).on('zoom', function(e){ g.attr('transform',e.transform); }));

  var nodeMap = {};
  graph.nodes.forEach(function(n){ nodeMap[n.id] = n; });

  var links = graph.links.filter(function(l){ return nodeMap[l.source] && nodeMap[l.target]; });

  var sim = d3.forceSimulation(graph.nodes)
    .force('link', d3.forceLink(links).id(function(d){ return d.id; }).distance(70).strength(0.5))
    .force('charge', d3.forceManyBody().strength(-180))
    .force('center', d3.forceCenter(W/2, H/2))
    .force('collision', d3.forceCollide(20));

  // Build adjacency map: node id → [{neighbor_name, edge_type, direction}]
  var adjMap = {};
  links.forEach(function(l){
    var sid = l.source.id || l.source, tid = l.target.id || l.target;
    var sname = nodeMap[sid] ? (nodeMap[sid].name||sid) : sid;
    var tname = nodeMap[tid] ? (nodeMap[tid].name||tid) : tid;
    var et = l.type || 'connected_to';
    if(!adjMap[sid]) adjMap[sid] = [];
    if(!adjMap[tid]) adjMap[tid] = [];
    adjMap[sid].push({name: tname, edge: et, dir: '→'});
    adjMap[tid].push({name: sname, edge: et, dir: '←'});
  });

  var _edgeTooltip = d3.select('#kg-tooltip');

  var link = g.append('g').selectAll('line').data(links).enter().append('line')
    .attr('stroke', function(d){ return EDGE_C[d.type] || EDGE_C.DEFAULT; })
    .attr('stroke-width', function(d){ return d.inferred ? 1 : 3; })
    .attr('stroke-dasharray', function(d){ return d.inferred ? '5,3' : null; })
    .attr('stroke-opacity', 0.65)
    .style('cursor','pointer')
    .on('mouseover', function(e, d){
      var sname = (d.source.name||d.source.id||'?').slice(0,35);
      var tname = (d.target.name||d.target.id||'?').slice(0,35);
      var et = d.type || 'connected_to';
      var conf = d.confidence ? ' <span style="color:#64748b">(' + Math.round(d.confidence*100) + '%)</span>' : '';
      var pg = d.page ? ' <span style="color:#64748b">p.' + d.page + '</span>' : '';
      _edgeTooltip.style('display','block')
        .style('left',(e.offsetX+14)+'px').style('top',(e.offsetY-10)+'px')
        .html('<div style="font-size:10px;color:#94a3b8;margin-bottom:4px">EDGE</div>' +
              '<span style="color:#60a5fa">' + sname + '</span>' +
              '<div style="margin:3px 0;padding:2px 6px;background:#2d3a5e;border-radius:4px;display:inline-block;font-size:10px;font-weight:700;color:#fbbf24">' + et + conf + '</div>' +
              '<span style="color:#34d399">' + tname + '</span>' + pg);
    })
    .on('mouseout', function(){ _edgeTooltip.style('display','none'); });

  var node = g.append('g').selectAll('g').data(graph.nodes).enter().append('g')
    .call(d3.drag()
      .on('start', function(e,d){ if(!e.active) sim.alphaTarget(0.3).restart(); d.fx=d.x; d.fy=d.y; })
      .on('drag',  function(e,d){ d.fx=e.x; d.fy=e.y; })
      .on('end',   function(e,d){ if(!e.active) sim.alphaTarget(0); d.fx=null; d.fy=null; }));

  // Node radius scaled by importance (DOCUMENT > GAEB > others)
  // Using mention_count concept: more connections = bigger node
  var linkCountMap = {};
  links.forEach(function(l){
    linkCountMap[l.source.id || l.source] = (linkCountMap[l.source.id || l.source]||0)+1;
    linkCountMap[l.target.id || l.target] = (linkCountMap[l.target.id || l.target]||0)+1;
  });

  function nodeRadius(d) {
    var base = d.type==='DOCUMENT' ? 14 : d.type==='GAEB_POSITION' ? 11 :
               d.type==='COMPANY' ? 12 : d.type==='DIN_STANDARD' ? 9 : 8;
    var deg = linkCountMap[d.id] || 0;
    return Math.min(base + Math.sqrt(deg) * 1.5, 22);
  }

  var tooltip = d3.select('#kg-tooltip');

  node.append('circle')
    .attr('r', nodeRadius)
    .attr('fill', function(d){ return NODE_C[d.type]||NODE_C.DEFAULT; })
    .attr('stroke', function(d){ return d.type==='DOCUMENT'?'#fff':'rgba(255,255,255,0.5)'; })
    .attr('stroke-width', function(d){ return d.type==='DOCUMENT'?2:1; })
    .attr('opacity', 0.92)
    .on('mouseover', function(e, d){
      var typeColor = {'DOCUMENT':'#3b5bdb','ACTOR':'#8b5cf6','PROCESS':'#0891b2',
        'MODEL':'#0d9488','CONSTRAINT':'#dc2626','STANDARD_OR_RULE':'#059669',
        'LIFECYCLE_PHASE':'#7c3aed','DATA_ENVIRONMENT':'#0369a1',
        'INFORMATION_REQUIREMENT':'#b45309','CONCEPT':'#475569'};
      var tc = typeColor[d.type] || '#475569';
      var neighbors = adjMap[d.id] || [];
      var nbHtml = '';
      if(neighbors.length){
        nbHtml = '<div style="margin-top:6px;border-top:1px solid #2d3a5e;padding-top:5px;font-size:10px;">';
        neighbors.slice(0,6).forEach(function(nb){
          nbHtml += '<div style="margin:2px 0">' +
            '<span style="color:#fbbf24;font-weight:700">' + nb.dir + ' ' + nb.edge + '</span> ' +
            '<span style="color:#cbd5e1">' + nb.name.slice(0,30) + '</span></div>';
        });
        if(neighbors.length > 6) nbHtml += '<div style="color:#64748b">+' + (neighbors.length-6) + ' more</div>';
        nbHtml += '</div>';
      }
      tooltip.style('display','block')
        .style('left', (e.offsetX+14)+'px')
        .style('top',  (e.offsetY-10)+'px')
        .html('<div style="font-weight:700;font-size:12px;margin-bottom:3px">' + (d.name||'').slice(0,45) + '</div>' +
              '<span style="background:' + tc + '33;color:' + tc + ';border:1px solid ' + tc + '66;border-radius:4px;padding:1px 6px;font-size:10px;font-weight:700">' + (d.type||'CONCEPT') + '</span>' +
              (d.page ? ' <span style="color:#64748b;font-size:10px">p.' + d.page + '</span>' : '') +
              (linkCountMap[d.id] ? '<div style="color:#94a3b8;font-size:10px;margin-top:3px">' + linkCountMap[d.id] + ' connection' + (linkCountMap[d.id]>1?'s':'') + '</div>' : '') +
              nbHtml);
    })
    .on('mouseout', function(){ tooltip.style('display','none'); });

  node.append('text')
    .attr('x', function(d){ return nodeRadius(d) + 4; })
    .attr('dy','0.35em')
    .attr('fill','#e2e8f0').attr('font-size','10px')
    .text(function(d){ var n=d.name||''; return n.length>22?n.slice(0,22)+'…':n; });

  sim.on('tick', function() {
    link.attr('x1',function(d){ return d.source.x; }).attr('y1',function(d){ return d.source.y; })
        .attr('x2',function(d){ return d.target.x; }).attr('y2',function(d){ return d.target.y; });
    node.attr('transform',function(d){ return 'translate('+d.x+','+d.y+')'; });
  });
}

// ── Source Viewer Modal ───────────────────────────────────────────────────────
function openSourceModal(s) {
  var overlay = $id('src-modal-overlay');
  var otype = s.origin_type || 'section';
  var _originIcon  = { section:'📄', table:'📊', image:'🖼️', stamp:'🔏', signature:'✍️' };
  var _originColor = { section:'#3b82f6', table:'#7c3aed', image:'#d97706', stamp:'#64748b', signature:'#64748b' };
  var icon  = _originIcon[otype]  || '📄';
  var color = _originColor[otype] || '#3b82f6';

  // Doc + page header
  $id('src-modal-doc').textContent = s.doc + '  —  p.' + s.page;

  // Origin badge
  var badge = $id('src-modal-badge');
  badge.textContent = icon + ' ' + otype.toUpperCase();
  badge.style.cssText = 'display:inline;background:' + color + '22;color:' + color +
    ';border:1px solid ' + color + '55;border-radius:5px;padding:2px 8px;font-size:10px;font-weight:700;margin-left:8px;';

  // Method badge
  var mbadge = $id('src-modal-method');
  if (mbadge) {
    mbadge.textContent = s.method ? s.method.toUpperCase() : '';
    mbadge.style.display = s.method ? 'inline' : 'none';
  }

  // Heading
  $id('src-modal-head').textContent = s.heading || ('Page ' + s.page);

  // Body — image preview, text snippet, or diagram notice
  var bodyEl = $id('src-modal-body');
  if (otype === 'image' && s.image_url) {
    bodyEl.innerHTML = '<img src="' + s.image_url + '" style="max-width:100%;border-radius:6px;border:1px solid #2d3748;" alt="source image">';
  } else if (s.snippet) {
    bodyEl.textContent = s.snippet;
  } else if (s.no_text || otype === 'image' || !s.snippet) {
    // Page has no extractable text — likely a diagram, figure, table image, or scan
    var adjHint = s.adj_context
      ? '<div style="margin-top:12px;padding:8px;background:#1e2a3a;border-radius:6px;text-align:left;font-size:11px;color:#7dd3fc;">' +
        '<span style="opacity:0.6;">Umgebungskontext: </span>' + s.adj_context + '</div>'
      : '';
    bodyEl.innerHTML =
      '<div style="text-align:center;padding:24px 16px;color:#94a3b8;">' +
        '<div style="font-size:32px;margin-bottom:8px;">🖼️</div>' +
        '<div style="font-size:13px;font-weight:600;margin-bottom:4px;">Diagramm- / Bildseite</div>' +
        '<div style="font-size:12px;">Diese Seite enthält eine Abbildung oder Tabelle.<br>' +
        'Kein Text extrahierbar — bitte PDF öffnen und zu Seite ' + s.page + ' navigieren.</div>' +
        adjHint +
      '</div>';
  }

  // PDF page link
  var linkEl = $id('src-modal-link');
  if (linkEl) {
    // Build a link that could open the PDF at the right page if served locally
    // For now: copy "doc p.N" to clipboard and show as reference
    linkEl.textContent = '↗ Jump to ' + s.doc + ' page ' + s.page;
    linkEl.onclick = function() {
      var ref = s.doc + ', page ' + s.page + (s.heading ? ', section "' + s.heading + '"' : '');
      navigator.clipboard && navigator.clipboard.writeText(ref);
      linkEl.textContent = '✓ Reference copied to clipboard';
      setTimeout(function(){ linkEl.textContent = '↗ Jump to ' + s.doc + ' page ' + s.page; }, 2000);
    };
  }

  overlay.classList.add('open');
}
function closeSrcModal() {
  $id('src-modal-overlay').classList.remove('open');
}
document.addEventListener('DOMContentLoaded', function() {
  $id('src-modal-overlay').addEventListener('click', function(e){
    if (e.target === this) closeSrcModal();
  });
  document.addEventListener('keydown', function(e){
    if (e.key === 'Escape') { closeSrcModal(); closeKGModal(); }
  });

  // Auto-populate model dropdown from Ollama
  fetch('http://localhost:11434/api/tags').then(function(r){ return r.json(); }).then(function(d){
    var sel = $id('qa-model-select');
    if (!sel || !d.models || !d.models.length) return;
    var preferred = ['mistral-small:24b','phi4:14b','qwen2.5-coder:7b','llama3.2:3b','claw-brain:latest'];
    var installed = d.models.map(function(m){ return m.name; });
    sel.innerHTML = '';
    // Show installed models, preferred order first
    var ordered = preferred.filter(function(m){ return installed.includes(m); })
      .concat(installed.filter(function(m){ return !preferred.includes(m); }));
    ordered.forEach(function(m, i){
      var opt = document.createElement('option');
      opt.value = m;
      opt.textContent = m + (i === 0 ? ' ✦' : '');
      if (i === 0) opt.selected = true;
      sel.appendChild(opt);
    });
  }).catch(function(){});
});

// ── KG Expand Modal ───────────────────────────────────────────────────────────
var _kgModalRels = [];

function openKGModal() {
  var overlay = $id('kg-modal-overlay');
  overlay.classList.add('open');
  // Gather current edges from the inline SVG data
  var wrap = $id('dc-kg-modal-wrap');
  wrap.innerHTML = '<div id="kg-modal-tooltip" style="position:absolute;display:none;background:#1e2a4a;color:#fff;padding:6px 10px;border-radius:6px;font-size:12px;pointer-events:none;max-width:260px;z-index:10;word-break:break-word;"></div>';
  if (_kgModalRels.length) {
    setTimeout(function() { buildModalKGGraph(_kgModalRels); }, 30);
  } else {
    wrap.innerHTML += '<div style="color:#8896b8;padding:20px;font-size:13px;">No graph data yet — extract a document first.</div>';
  }
}

function closeKGModal() {
  $id('kg-modal-overlay').classList.remove('open');
}

// Close on overlay backdrop click
document.addEventListener('DOMContentLoaded', function() {
  $id('kg-modal-overlay').addEventListener('click', function(e) {
    if (e.target === this) closeKGModal();
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeKGModal();
  });
});

function buildModalKGGraph(rels) {
  var wrap = $id('dc-kg-modal-wrap');
  // Remove old svg if present
  var old = wrap.querySelector('svg');
  if (old) old.remove();

  var W = wrap.offsetWidth  || window.innerWidth  * 0.9;
  var H = wrap.offsetHeight || window.innerHeight * 0.8;

  var typeGuess = function(name) {
    if (/BIM-(Management|Projektleitung|Koordination|Fach)/i.test(name)) return 'ROLE';
    if (/Foundation|Schulung|Zertifikat/i.test(name)) return 'REQUIREMENT';
    if (/Workflow|WF\d|Issue|BCF/i.test(name)) return 'WORKFLOW';
    if (/LOG|LOI|LOIN|LOD/i.test(name)) return 'STANDARD';
    if (/CDE|Modell|Archiv/i.test(name)) return 'DATA';
    if (/Prozess|Prüfung|Erstellung|Bearbeitung/i.test(name)) return 'PROCESS';
    if (/Leitfaden|Masterplan|Dokument|BIM-Leitfaden/i.test(name)) return 'DOCUMENT';
    return 'CONCEPT';
  };

  var nodeMap = {};
  rels.forEach(function(r) {
    if (!nodeMap[r.source]) nodeMap[r.source] = { id: r.source, name: r.source, type: r.source_type || typeGuess(r.source) };
    if (!nodeMap[r.target]) nodeMap[r.target] = { id: r.target, name: r.target, type: r.target_type || typeGuess(r.target) };
  });
  var nodes = Object.values(nodeMap);
  var links = rels.map(function(r) { return { source: r.source, target: r.target, type: r.type }; });

  var svg = d3.select(wrap).append('svg')
    .attr('width', W).attr('height', H)
    .style('width','100%').style('height','100%')
    .style('background', '#0f172a');

  var g = svg.append('g');
  svg.call(d3.zoom().scaleExtent([0.1, 8]).on('zoom', function(e) { g.attr('transform', e.transform); }));

  var linkCount = {};
  links.forEach(function(l) {
    linkCount[l.source] = (linkCount[l.source] || 0) + 1;
    linkCount[l.target] = (linkCount[l.target] || 0) + 1;
  });

  var sim = d3.forceSimulation(nodes)
    .force('link', d3.forceLink(links).id(function(d) { return d.id; }).distance(80).strength(0.8))
    .force('charge', d3.forceManyBody().strength(-220).distanceMax(400))
    .force('center', d3.forceCenter(W / 2, H / 2).strength(0.08))
    .force('x', d3.forceX(W / 2).strength(0.04))
    .force('y', d3.forceY(H / 2).strength(0.04))
    .force('collision', d3.forceCollide(28))
    .alphaDecay(0.018);

  var link = g.append('g').selectAll('line').data(links).enter().append('line')
    .attr('stroke', '#8896b8').attr('stroke-width', 1.5).attr('stroke-opacity', 0.7);

  var colorMap = { ROLE:'#6366f1', STANDARD:'#0ea5e9', DELIVERABLE:'#10b981',
                   PROCESS:'#f59e0b', CONSTRAINT:'#ef4444', CONCEPT:'#38bdf8',
                   REQUIREMENT:'#a78bfa', WORKFLOW:'#fb923c', DATA:'#34d399', DOCUMENT:'#f472b6' };

  var tooltip = d3.select('#kg-modal-tooltip');
  var node = g.append('g').selectAll('g').data(nodes).enter().append('g')
    .call(d3.drag()
      .on('start', function(e, d) { if (!e.active) sim.alphaTarget(0.3).restart(); d.fx = d.x; d.fy = d.y; })
      .on('drag',  function(e, d) { d.fx = e.x; d.fy = e.y; })
      .on('end',   function(e, d) { if (!e.active) sim.alphaTarget(0); d.fx = null; d.fy = null; }));

  function nodeR(d) { return Math.min(10 + Math.sqrt(linkCount[d.id] || 0) * 3, 26); }

  node.append('circle')
    .attr('r', nodeR)
    .attr('fill', function(d) { return colorMap[d.type] || '#38bdf8'; })
    .attr('fill-opacity', 0.85)
    .attr('stroke', '#1e293b').attr('stroke-width', 2)
    .on('mouseover', function(e, d) {
      tooltip.style('display','block').html('<strong>' + d.name + '</strong><br/><span style="color:#94a3b8;font-size:10px;">' + d.type + ' · ' + (linkCount[d.id]||0) + ' connections</span>');
    })
    .on('mousemove', function(e) {
      var rect = wrap.getBoundingClientRect();
      tooltip.style('left', (e.clientX - rect.left + 12) + 'px').style('top', (e.clientY - rect.top - 10) + 'px');
    })
    .on('mouseout', function() { tooltip.style('display','none'); });

  node.append('text')
    .attr('dy', function(d) { return nodeR(d) + 13; })
    .attr('text-anchor','middle')
    .attr('font-size', '11px').attr('fill','#cbd5e1').attr('font-weight','600')
    .text(function(d) { return d.name.length > 22 ? d.name.slice(0,20) + '…' : d.name; });

  sim.on('tick', function() {
    link.attr('x1',function(d){return d.source.x;}).attr('y1',function(d){return d.source.y;})
        .attr('x2',function(d){return d.target.x;}).attr('y2',function(d){return d.target.y;});
    node.attr('transform',function(d){return 'translate('+d.x+','+d.y+')';});
  });
}
</script>

<!-- Source Viewer Modal -->
<div id="src-modal-overlay">
  <div id="src-modal-box" style="position:relative;">
    <button id="src-modal-close-btn" onclick="closeSrcModal()" title="Close (Esc)">✕</button>
    <div id="src-modal-hdr">
      <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
        <div id="src-modal-doc"></div>
        <span id="src-modal-badge"></span>
        <span id="src-modal-method" style="display:none;background:#334155;color:#94a3b8;border-radius:5px;padding:2px 7px;font-size:9px;font-weight:700;"></span>
      </div>
      <div id="src-modal-head"></div>
    </div>
    <div id="src-modal-content">
      <pre id="src-modal-body"></pre>
      <button id="src-modal-link" style="margin-top:12px;background:none;border:1px solid #334155;border-radius:6px;color:#7dd3fc;padding:6px 12px;font-size:11px;cursor:pointer;width:100%;text-align:left;transition:background 0.15s;" onmouseenter="this.style.background='rgba(125,211,252,0.08)'" onmouseleave="this.style.background='none'"></button>
    </div>
  </div>
</div>

<!-- KG Expand Modal -->
<div id="kg-modal-overlay">
  <div id="kg-modal-box">
    <div id="kg-modal-hdr">
      <span>🕸️</span>
      <h3>Knowledge Graph — Full View</h3>
      <span id="kg-modal-count" style="background:#1e3a5f;color:#7dd3fc;border-radius:10px;padding:2px 10px;font-size:11px;font-weight:700;"></span>
      <button id="kg-modal-close" onclick="closeKGModal()" title="Close (Esc)">✕</button>
    </div>
    <div id="dc-kg-modal-wrap" id="kg-modal-wrap" style="flex:1;position:relative;overflow:hidden;">
      <div id="kg-modal-tooltip"></div>
    </div>
  </div>
</div>
</body>
</html>
