# Copy to `.env` and fill in. The .env file is git-ignored.
# --- Provider keys (set the one matching MODEL's provider prefix) ---
# Gemini: accepted as GOOGLE_API_KEY or GEMINI_API_KEY.
GOOGLE_API_KEY=your-gemini-key-here
# Anthropic: accepted as ANTHROPIC_API_KEY or CLAUDE_API_KEY.
CLAUDE_API_KEY=your-anthropic-key-here
# LLM for the orchestrator, harvest, and answer synthesis (provider-prefixed).
#   anthropic:claude-haiku-4-5-20251001  |  google_genai:gemini-3.5-flash
#   openai:qwen/qwen3.6-35b-a3b  (local, via LM Studio — set LLM_BASE_URL below)
MODEL=anthropic:claude-haiku-4-5-20251001
# For a local OpenAI-compatible LLM (LM Studio): point here + use an openai:<id> MODEL.
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=lm-studio
# --- Multimodal retrieval (ColModernVBERT, MIT, ~250M, CPU/MPS-capable) ---
EMBED_MODEL=ModernVBERT/colmodernvbert
# auto | mps | cuda | cpu  (auto picks mps on Apple Silicon)
EMBED_DEVICE=auto
# --- Postgres (knowledge graph + multi-vector store, via VectorChord) ---
# Matches docker-compose.yml defaults.
DATABASE_URL=postgresql://matescale:matescale@127.0.0.1:5433/matescale_rag
# --- Harvest (windowed entity/relation extraction into the graph) ---
# Pages per extraction window (1 = exact per-page provenance); overlap re-reads
# the last N pages so cross-page relations aren't lost.
HARVEST_WINDOW=3
HARVEST_OVERLAP=1
# Auto-harvest into the graph + write the OKF summary as part of ingestion.
# Set false to ingest vectors only and harvest later via the Harvester.
HARVEST_ON_INGEST=true
# GraphCurator: conservative LLM dedup of entity names during harvest (runs in
# parallel with the document summary). Collapses acronym/morphology/near-dups.
CURATE_ON_HARVEST=true
# --- OKF wiki bundle + corpus/data dirs (defaults are in-tree) ---
# OKF_DIR=okf
# DATA_DIR=data
# --- Server ---
HOST=127.0.0.1
PORT=8000
# --- Sandbox: real filesystem + `execute` shell, scoped to ./workspace ---
# Scoped to the workspace dir, no host-env inheritance — NOT kernel-isolated.
SANDBOX=true
# WORKSPACE_DIR=workspace
# --- Workflow interpreter: per-eval wall-clock budget (seconds) for QuickJS ---
INTERPRETER_TIMEOUT=600
